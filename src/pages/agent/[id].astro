---
import Layout from "@/layouts/Layout.astro";
import { getLocale, getMessages } from "@/lib/i18n";

const locale = getLocale(Astro);
const m = getMessages(locale);
const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/agent");
}

const pageTitle = `${m.agentBuild.previewTitle} — Rizki Ramadhan`;
const pageDescription = m.agentBuild.previewDescription;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbCurrent={m.agentBuild.previewTitle}
  noIndex={true}
>
  <main
    id="agent-build-detail"
    data-build-id={id}
    class="agent-build-full fixed inset-0 z-50 bg-white"
  >
    <iframe
      id="agent-build-frame"
      class="block size-full border-0"
      title={m.agentBuild.previewTitle}
      sandbox="allow-scripts allow-modals allow-forms allow-popups"
    ></iframe>
  </main>
</Layout>

<script>
  import { bindAgentBuildDetail } from "@/service/agent/build-detail.client";

  bindAgentBuildDetail();
</script>

<style is:global>
  .agent-build-full {
    color-scheme: light;
  }
</style>
