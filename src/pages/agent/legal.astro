---
import Layout from "@/layouts/Layout.astro";
import Aside from "@/components/ui/aside.astro";
import Card from "@/components/ui/card.astro";
import AgentHeader from "@/layouts/agent-header.astro";
import Textarea from "@/components/ui/textarea.astro";
import {
  LEGAL_AGENT_CATEGORY,
  LEGAL_CATEGORY_CARDS,
} from "@/service/agent/legal.service";
---

<Layout
  title="AI Studio · Legal"
  description="Bantu drafting dokumen hukum, ringkas klausul, dan analisis risiko secara terstruktur."
  noIndex={true}
>
  <Aside homeHref="/agent" />

  <main
    id="agent-main"
    class="relative flex min-w-0 flex-1 flex-col overflow-hidden md:flex-row"
  >
    <div
      class="agent-chat-pane relative flex min-w-0 flex-1 flex-col overflow-hidden"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div
          class="absolute top-[-20%] right-[-10%] size-[50%] rounded-full bg-accent/5 blur-[120px]"
        >
        </div>
        <div
          class="absolute bottom-[-20%] left-[-10%] size-[50%] rounded-full bg-foreground/5 blur-[120px]"
        >
        </div>
      </div>

      <AgentHeader title="Legal Engine" />

      <div
        id="agent-messages"
        class="agent-scrollbar relative min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 py-12 md:px-12"
      >
        <div id="agent-thread" class="mx-auto max-w-4xl space-y-16">
          <div class="py-20 text-center" id="agent-empty-state">
            <h2
              class="mb-6 font-display text-5xl font-light opacity-80 italic md:text-6xl"
            >
              Draft with <br />
              <span class="font-bold text-foreground not-italic">clarity.</span>
            </h2>
            <p class="text-lg font-light text-muted-foreground">
              Bantu drafting dokumen hukum, ringkas klausul, dan analisis risiko
              secara terstruktur.
            </p>

            <div
              id="agent-category-cards"
              class="agent-category-cards mx-auto mt-12 max-w-4xl text-left"
            >
              <ul class="agent-category-cards__list">
                {
                  LEGAL_CATEGORY_CARDS.map((item) => (
                    <li>
                      <Card
                        variant="select"
                        title={item.title}
                        categoryLabel={item.categoryLabel}
                        description={item.description}
                        category={item.category}
                        prompt={item.prompt}
                      />
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="agent-prompt-dock shrink-0 pb-4 px-6 pt-4 md:px-12">
        <div class="mx-auto max-w-4xl">
          <p
            id="agent-error"
            class="mb-3 hidden rounded-2xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
            role="alert"
            aria-live="polite"
          >
          </p>

          <form id="agent-prompt-form">
            <input type="hidden" name="category" value={LEGAL_AGENT_CATEGORY} />

            <Textarea
              variant="prompt"
              id="main-prompt-input"
              name="message"
              label="Type your legal prompt..."
              maxlength={4000}
              required
            />
          </form>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { bindLegalAgent } from "@/service/agent/legal.service";

  bindLegalAgent();
</script>

<style>
  .agent-category-cards__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .agent-category-cards__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
