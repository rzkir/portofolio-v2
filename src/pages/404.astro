---
import Layout from "@/layouts/Layout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import FocusIn from "@/components/FocusIn.astro";
import { getLocale, getMessages } from "@/lib/i18n";

Astro.response.status = 404;

const locale = getLocale(Astro);
const m = getMessages(locale);
const nf = m.notFound;
---

<Layout
  title={m.meta.notFoundTitle}
  description={m.meta.notFoundDescription}
  noIndex={true}
>
  <Header />

  <main class="pt-28">
    <section
      class="mx-auto flex min-h-[calc(100svh-8rem)] w-full container flex-col items-center justify-center px-4 py-16 text-center md:px-6 md:py-20"
    >
      <p
        class="mb-2 animate-focus select-none font-body text-[clamp(5.5rem,17vw,10rem)] font-light leading-none tracking-tight whitespace-nowrap text-foreground/60"
        aria-hidden="true"
      >
        {nf.code}
      </p>

      <FocusIn delay={60}>
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/5 px-3 py-1"
        >
          <span class="size-1.5 pulse-soft rounded-full bg-accent"></span>
          <span class="font-mono text-xs tracking-widest text-accent uppercase"
            >{nf.badge}</span
          >
        </div>
      </FocusIn>

      <FocusIn delay={100}>
        <h1
          class="mb-5 max-w-2xl text-balance font-display text-4xl italic leading-[0.95] md:text-5xl lg:text-6xl"
        >
          {nf.title}
          <span class="text-accent"> {nf.titleAccent}</span>
        </h1>
      </FocusIn>

      <FocusIn delay={140}>
        <p
          class="mx-auto mb-10 max-w-md text-pretty text-base leading-relaxed text-muted-foreground md:text-lg"
        >
          {nf.body}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            data-cursor="focus"
            data-cursor-label="Home"
            class="rounded-full bg-foreground px-8 py-4 text-sm font-medium text-background transition-colors hover:bg-accent"
          >
            {nf.backHome}
          </a>
          <a
            href="/works"
            data-cursor="focus"
            data-cursor-label="Works"
            class="rounded-full border border-border px-8 py-4 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
          >
            {nf.browseWorks}
          </a>
          <a
            href="/blog"
            data-cursor="focus"
            data-cursor-label="Blog"
            class="rounded-full border border-border px-8 py-4 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
          >
            {nf.browseBlog}
          </a>
        </div>

        <p
          class="mt-8 font-mono text-xs tracking-[0.15em] text-muted-foreground uppercase"
        >
          {nf.hint}
        </p>
      </FocusIn>
    </section>
  </main>

  <Footer />
</Layout>
