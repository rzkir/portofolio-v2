---
import Layout from "@/layouts/Layout.astro";
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import { cn } from "@/lib/utiles";
import { getLocale, getMessages } from "@/lib/i18n";

const locale = getLocale(Astro);
const m = getMessages(locale);
const t = m.termsPage;
const l = m.legal;

const legalEmail = "legal@rizkiramadhan.biz.id";

const otherDocuments = [
  {
    href: "/privacy",
    label: l.privacyPolicy,
    icon: "shield" as const,
  },
  {
    href: "/help-center",
    label: l.helpCenter,
    icon: "help" as const,
  },
] as const;

const navLinkClass =
  "block py-1 text-[13px] text-foreground transition-colors hover:text-muted-foreground";
const sectionTitleClass = "font-display text-3xl font-normal";
---

<Layout
  title={m.meta.termsTitle}
  description={m.meta.termsDescription}
  breadcrumbCurrent={t.breadcrumb}
>
  <Header />

  <main class="pt-28">
    <div class="mx-auto container px-4 md:px-6 pb-10">
      <div class="flex items-start gap-0 lg:gap-12">
        <aside
          class="legal-sidebar sticky top-28 hidden w-72 shrink-0 flex-col self-start lg:flex"
          aria-label={l.sidebarAria}
        >
          <div
            class="flex max-h-[calc(100dvh-7rem)] flex-col overflow-hidden rounded-2xl border border-border bg-surface/40"
          >
            <div class="border-b border-border p-6">
              <h2 class="font-display text-2xl font-normal tracking-tight">
                {l.sidebarTitle}
              </h2>
              <p
                class="mt-1 text-[11px] tracking-widest text-muted-foreground uppercase"
              >
                {l.documentNavigation}
              </p>
            </div>

            <div class="legal-scrollbar flex-1 overflow-y-auto p-6">
              <nav class="space-y-4">
                <div class="space-y-1">
                  <span
                    class="mb-2 block text-[10px] font-bold tracking-[0.15em] text-muted-foreground uppercase"
                  >
                    {l.tableOfContents}
                  </span>
                  {
                    t.toc.map((item) => (
                      <a href={`#${item.id}`} class={navLinkClass}>
                        {item.label}
                      </a>
                    ))
                  }
                </div>

                <div class="space-y-3 pt-8">
                  <span
                    class="mb-2 block text-[10px] font-bold tracking-[0.15em] text-muted-foreground uppercase"
                  >
                    {l.otherDocuments}
                  </span>
                  {
                    otherDocuments.map((doc) => (
                      <a
                        href={doc.href}
                        class="flex items-center gap-2 rounded-xl px-3 py-2 text-[13px] transition-colors hover:bg-foreground/5"
                      >
                        {doc.icon === "shield" && (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-4 shrink-0"
                            aria-hidden="true"
                          >
                            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                            <path d="m9 12 2 2 4-4" />
                          </svg>
                        )}
                        {doc.icon === "help" && (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-4 shrink-0"
                            aria-hidden="true"
                          >
                            <circle cx="12" cy="12" r="10" />
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                            <path d="M12 17h.01" />
                          </svg>
                        )}
                        {doc.label}
                      </a>
                    ))
                  }
                </div>
              </nav>
            </div>

            <div class="border-t border-border bg-background/50 p-6">
              <p class="text-[10px] leading-relaxed text-muted-foreground">
                {l.lastUpdated}<br />
                {l.effectiveImmediately}
              </p>
            </div>
          </div>
        </aside>

        <article class="min-w-0 flex-1 py-12 lg:max-w-3xl">
          <nav
            class="mb-10 flex flex-wrap gap-2 lg:hidden"
            aria-label={l.tocAria}
          >
            {
              t.toc.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="rounded-full border border-border px-3 py-1 text-[11px] tracking-wide text-muted-foreground transition-colors hover:text-foreground"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <header class="mb-16">
            <h1
              class="mb-4 font-display text-5xl font-light tracking-tight md:text-6xl"
            >
              {t.titleMain} <span class="italic">{t.titleAccent}</span>
            </h1>
            <div class="mb-6 h-px w-24 bg-foreground"></div>
            <p class="text-lg font-light text-muted-foreground italic">
              {t.subtitle}
            </p>
          </header>

          <div class="space-y-12">
            <section id="introduction" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>{t.introduction.title}</h2>
              <div
                class="space-y-4 text-sm leading-relaxed font-light text-foreground/80"
              >
                <p>{t.introduction.p1}</p>
                <p>{t.introduction.p2}</p>
              </div>
            </section>

            <section id="acceptable-use" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>{t.acceptableUse.title}</h2>
              <div class="space-y-4">
                <details
                  class="legal-details group border-b border-border pb-4"
                  open
                >
                  <summary
                    class="flex cursor-pointer list-none items-center justify-between text-sm font-medium tracking-tight transition-colors hover:text-muted-foreground"
                  >
                    {t.acceptableUse.coreTitle}
                  </summary>
                  <div
                    class="space-y-3 pt-4 text-sm leading-relaxed font-light text-foreground/75"
                  >
                    <p>{t.acceptableUse.coreP1}</p>
                    <p>{t.acceptableUse.coreP2}</p>
                    <ul class="list-disc space-y-2 pl-5">
                      {
                        t.acceptableUse.coreItems.map((item) => (
                          <li>{item}</li>
                        ))
                      }
                    </ul>
                  </div>
                </details>

                <details
                  class="legal-details group border-b border-border pb-4"
                >
                  <summary
                    class="flex cursor-pointer list-none items-center justify-between text-sm font-medium tracking-tight transition-colors hover:text-muted-foreground"
                  >
                    {t.acceptableUse.techTitle}
                  </summary>
                  <div
                    class="pt-4 text-sm leading-relaxed font-light text-foreground/75"
                  >
                    <p>
                      {t.acceptableUse.techP1}
                      <code
                        class="rounded bg-foreground/5 px-1 font-mono text-[0.8125rem]"
                        >Deep-Intell-v4</code
                      >
                      {t.acceptableUse.techP1Suffix}
                    </p>
                  </div>
                </details>
              </div>
            </section>

            <section id="responsibilities" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>
                {t.responsibilities.title}
              </h2>
              <div
                class="rounded-2xl border border-border/70 bg-surface/50 p-8"
              >
                <div
                  class="space-y-6 text-sm leading-relaxed font-light text-foreground/80"
                >
                  <div class="flex gap-4">
                    <span
                      class="mt-1 font-mono text-[10px] text-muted-foreground"
                      >03.1</span
                    >
                    <p>
                      <strong>{t.responsibilities.accountLabel}</strong>
                      {t.responsibilities.accountBody}
                    </p>
                  </div>
                  <div class="flex gap-4">
                    <span
                      class="mt-1 font-mono text-[10px] text-muted-foreground"
                      >03.2</span
                    >
                    <p>
                      <strong>{t.responsibilities.accuracyLabel}</strong>
                      {t.responsibilities.accuracyBody}
                    </p>
                  </div>
                </div>
              </div>
            </section>

            <section id="intellectual-property" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>
                {t.intellectualProperty.title}
              </h2>
              <div
                class="space-y-4 text-sm leading-relaxed font-light text-foreground/80"
              >
                <p>{t.intellectualProperty.p1}</p>
                <p>{t.intellectualProperty.p2}</p>
              </div>
            </section>

            <section id="liability" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>
                {t.liability.title}
              </h2>
              <div class="border-l-2 border-foreground py-2 pl-8">
                <p
                  class="mb-4 text-sm font-bold tracking-widest text-foreground uppercase"
                >
                  {t.liability.disclaimer}
                </p>
                <p
                  class="text-sm leading-relaxed font-light text-foreground/75 italic"
                >
                  "{t.liability.quote}"
                </p>
              </div>
            </section>

            <section id="contact" class="scroll-mt-32">
              <h2 class={cn(sectionTitleClass, "mb-6")}>
                {t.contact.title}
              </h2>
              <p
                class="mb-8 text-sm leading-relaxed font-light text-foreground/80"
              >
                {t.contact.body}
              </p>
              <a
                href={`mailto:${legalEmail}`}
                class="inline-flex items-center gap-3 rounded-2xl bg-foreground px-8 py-4 text-background transition-all hover:bg-foreground/85 active:scale-[0.98]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4"
                  aria-hidden="true"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                <span class="font-medium">{legalEmail}</span>
              </a>
            </section>
          </div>

          <div class="mt-32 border-t border-border pt-12 text-center">
            <a
              href="#introduction"
              class="text-[11px] font-bold tracking-widest uppercase transition-colors hover:text-muted-foreground"
            >
              {l.backToTop}
            </a>
          </div>
        </article>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--foreground) 18%, transparent)
      transparent;
  }

  .legal-scrollbar::-webkit-scrollbar {
    width: 4px;
  }

  .legal-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }

  .legal-scrollbar::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--foreground) 14%, transparent);
    border-radius: 10px;
  }

  .legal-details > summary::-webkit-details-marker {
    display: none;
  }

  .legal-details summary::after {
    content: "+";
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .legal-details[open] summary::after {
    content: "−";
  }
</style>
