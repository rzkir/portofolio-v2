---
import GrabCursor from "@/components/GrabCursor.astro";
import ModalPopup from "@/components/ModalPopup.astro";
import Announcement from "@/layouts/announcement.astro";
import NotificationContext from "@/layouts/NotificationContext.astro";
import SettingsContext from "@/layouts/SettingsContext.astro";
import SplashScreen from "@/components/SplashScreen.astro";
import { FORCE_MOTION_INLINE_SCRIPT } from "@/lib/force-motion";
import {
  createGtmInlineScript,
  SPLASH_INLINE_SCRIPT,
  THEME_INLINE_SCRIPT,
} from "@/lib/layout";
import { absoluteLangHref, getLocale, getMessages, LOCALES } from "@/lib/i18n";
import {
  getSiteVerification,
  resolvePageMetadata,
  type OgType,
} from "@/lib/metadata";
import "@/styles/global.css";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  breadcrumbCurrent?: string;
  noIndex?: boolean;
  noGrabCursor?: boolean;
}

const locale = getLocale(Astro);
const m = getMessages(locale);

const {
  title = m.meta.siteTitle,
  description = m.meta.siteDescription,
  ogImage,
  ogType,
  breadcrumbCurrent,
  noIndex,
  noGrabCursor = false,
} = Astro.props;

const meta = resolvePageMetadata({
  site: Astro.site,
  pathname: Astro.url.pathname,
  locale,
  title,
  description,
  ogImage,
  ogType,
  breadcrumbCurrent,
  noIndex,
  messages: m,
});

const verification = getSiteVerification();
const isAgentRoute = Astro.url.pathname.startsWith("/agent");
const siteOrigin = Astro.site?.origin ?? "https://rizkiramadhan.biz.id";
const sitemapUrl = new URL("/sitemap.xml", siteOrigin).href;
---

<!doctype html>
<html
  lang={locale}
  data-grab-cursor={noGrabCursor ? "off" : undefined}
  data-has-announcement={!isAgentRoute ? "" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={FORCE_MOTION_INLINE_SCRIPT} />
    <script is:inline set:html={SPLASH_INLINE_SCRIPT} />
    <script is:inline set:html={THEME_INLINE_SCRIPT} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#3d3830" />
    <meta name="theme-color" content="#3d3830" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="R. Ramadhan" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <meta name="generator" content={Astro.generator} />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} type="application/xml" />
    {meta.robots && <meta name="robots" content={meta.robots} />}

    {
      LOCALES.map((lang) => (
        <link
          rel="alternate"
          hreflang={lang}
          href={absoluteLangHref(
            siteOrigin,
            Astro.url.pathname,
            Astro.url.search,
            lang,
          )}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={meta.canonicalUrl} />

    {
      verification.googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={verification.googleSiteVerification}
        />
      )
    }
    {
      verification.bingSiteVerification && (
        <meta
          name="msvalidate.01"
          content={verification.bingSiteVerification}
        />
      )
    }

    <meta property="og:type" content={meta.og.type} />
    <meta property="og:site_name" content={meta.og.siteName} />
    <meta property="og:locale" content={meta.og.locale} />
    <meta property="og:locale:alternate" content={meta.og.localeAlternate} />
    <meta property="og:title" content={meta.og.title} />
    <meta property="og:description" content={meta.og.description} />
    <meta property="og:url" content={meta.og.url} />
    <meta property="og:image" content={meta.og.image} />
    <meta property="og:image:alt" content={meta.og.title} />

    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />

    {
      meta.siteJsonLd && (
        <script type="application/ld+json" set:html={meta.siteJsonLd} />
      )
    }

    {
      meta.breadcrumbJsonLd && (
        <script
          id="page-breadcrumb-jsonld"
          type="application/ld+json"
          set:html={meta.breadcrumbJsonLd}
        />
      )
    }

    {
      verification.googleTagManagerId && (
        <script
          is:inline
          set:html={createGtmInlineScript(verification.googleTagManagerId)}
        />
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    {
      verification.googleTagManagerId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${verification.googleTagManagerId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"></iframe>
        </noscript>
      )
    }
    <SplashScreen />
    {!noGrabCursor && <GrabCursor />}
    <NotificationContext />
    {isAgentRoute && <SettingsContext />}
    {!isAgentRoute && <Announcement />}
    {
      isAgentRoute ? (
        <div class="agent-shell flex h-dvh w-full bg-background text-foreground">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
    {!isAgentRoute && <ModalPopup />}
    <script>
      import { initLayout } from "@/lib/layout";

      initLayout();
    </script>
  </body>
</html>
