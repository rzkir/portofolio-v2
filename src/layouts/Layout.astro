---
import GrabCursor from "@/components/GrabCursor.astro";
import Announcement from "@/layouts/announcement.astro";
import NotificationContext from "@/layouts/NotificationContext.astro";
import SplashScreen from "@/components/SplashScreen.astro";
import { FORCE_MOTION_INLINE_SCRIPT } from "@/lib/force-motion";
import { absoluteLangHref, getLocale, getMessages } from "@/lib/i18n";
import {
  getSiteVerification,
  resolvePageMetadata,
  type OgType,
} from "@/lib/metadata";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  breadcrumbCurrent?: string;
  noIndex?: boolean;
  noGrabCursor?: boolean;
}

const locale = getLocale(Astro);
const m = getMessages(locale);

const {
  title = m.meta.siteTitle,
  description = m.meta.siteDescription,
  ogImage,
  ogType,
  breadcrumbCurrent,
  noIndex,
  noGrabCursor = false,
} = Astro.props;

const meta = resolvePageMetadata({
  site: Astro.site,
  pathname: Astro.url.pathname,
  locale,
  title,
  description,
  ogImage,
  ogType,
  breadcrumbCurrent,
  noIndex,
  messages: m,
});

const verification = getSiteVerification();
const isAgentRoute = Astro.url.pathname.startsWith("/agent");
const siteOrigin = Astro.site?.origin ?? "https://rizkiramadhan.biz.id";
const sitemapUrl = new URL("/sitemap.xml", siteOrigin).href;
---

<!doctype html>
<html lang={locale} data-grab-cursor={noGrabCursor ? "off" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={FORCE_MOTION_INLINE_SCRIPT} />
    <script is:inline>
      try {
        var isCrawler =
          /bot|crawl|spider|slurp|mediapartners|bingpreview|facebookexternalhit/i.test(
            navigator.userAgent,
          );

        if (isCrawler || sessionStorage.getItem("splash-seen") === "1") {
          document.documentElement.classList.add("splash-seen");
        } else {
          document.documentElement.classList.add("splash-pending");
        }
      } catch (_) {
        document.documentElement.classList.add("splash-pending");
      }
    </script>
    <script is:inline>
      (function () {
        try {
          var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var root = document.documentElement;

          if (dark) root.classList.add("dark");
          root.setAttribute("data-theme", "system");
          root.setAttribute("data-theme-resolved", dark ? "dark" : "light");
          root.style.colorScheme = dark ? "dark" : "light";
        } catch (_) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} type="application/xml" />
    {meta.robots && <meta name="robots" content={meta.robots} />}

    <link
      rel="alternate"
      hreflang="id"
      href={absoluteLangHref(
        siteOrigin,
        Astro.url.pathname,
        Astro.url.search,
        "id",
      )}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={absoluteLangHref(
        siteOrigin,
        Astro.url.pathname,
        Astro.url.search,
        "en",
      )}
    />
    <link rel="alternate" hreflang="x-default" href={meta.canonicalUrl} />

    {
      verification.googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={verification.googleSiteVerification}
        />
      )
    }
    {
      verification.bingSiteVerification && (
        <meta
          name="msvalidate.01"
          content={verification.bingSiteVerification}
        />
      )
    }

    <meta property="og:type" content={meta.og.type} />
    <meta property="og:site_name" content={meta.og.siteName} />
    <meta property="og:locale" content={meta.og.locale} />
    <meta property="og:locale:alternate" content={meta.og.localeAlternate} />
    <meta property="og:title" content={meta.og.title} />
    <meta property="og:description" content={meta.og.description} />
    <meta property="og:url" content={meta.og.url} />
    <meta property="og:image" content={meta.og.image} />
    <meta property="og:image:alt" content={meta.og.title} />

    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />

    {
      meta.siteJsonLd && (
        <script type="application/ld+json" set:html={meta.siteJsonLd} />
      )
    }

    {
      meta.breadcrumbJsonLd && (
        <script
          id="page-breadcrumb-jsonld"
          type="application/ld+json"
          set:html={meta.breadcrumbJsonLd}
        />
      )
    }

    {
      verification.googleTagManagerId && (
        <script
          is:inline
          define:vars={{ gtmId: verification.googleTagManagerId }}
        >
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, "script", "dataLayer", gtmId);
        </script>
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      verification.googleTagManagerId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${verification.googleTagManagerId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"></iframe>
        </noscript>
      )
    }
    <SplashScreen />
    {!noGrabCursor && <GrabCursor />}
    <NotificationContext />
    {!isAgentRoute && <Announcement />}
    {
      isAgentRoute ? (
        <div class="agent-shell flex h-dvh w-full bg-background text-foreground">
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
    <link rel="stylesheet" href="/force-motion.css" />

    <script>
      import { bindTheme } from "@/lib/theme";

      function initTheme() {
        bindTheme();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTheme, {
          once: true,
        });
      } else {
        initTheme();
      }

      document.addEventListener("astro:page-load", initTheme);
    </script>
  </body>
</html>
