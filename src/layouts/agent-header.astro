---
import ThemeSwitch from "@/components/ui/switch.astro";
import { cn } from "@/lib/utiles";

interface Props {
  title: string;
  version?: string;
  showHistory?: boolean;
  class?: string;
  openHistoryLabel?: string;
  settingsLabel?: string;
}

const {
  title,
  version = "v4",
  showHistory = false,
  class: className,
  openHistoryLabel = "Open conversation history",
  settingsLabel = "Settings",
} = Astro.props;
---

<header
  class={cn(
    "agent-header relative z-10 flex min-h-16 shrink-0 items-center justify-between gap-3 border-b border-border bg-background/80 py-3 pl-14 pr-4 backdrop-blur-md sm:min-h-20 sm:pr-6 md:pl-12 md:pr-12",
    className,
  )}
>
  <div class="min-w-0 flex-1">
    <h1
      class="truncate font-display text-lg font-light tracking-wide italic sm:text-2xl md:text-3xl"
    >
      {title}
      <span class="ml-1.5 font-bold text-accent not-italic sm:ml-2"
        >{version}</span
      >
    </h1>
  </div>

  <div class="flex shrink-0 items-center gap-2 sm:gap-4 md:gap-6">
    {
      showHistory ? (
        <button
          type="button"
          id="agent-history-toggle"
          class="text-muted-foreground transition-colors hover:text-foreground md:hidden"
          aria-label={openHistoryLabel}
          aria-controls="agent-history-panel"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
            <path d="M3 3v5h5" />
            <path d="M12 7v5l4 2" />
          </svg>
        </button>
      ) : null
    }

    <ThemeSwitch />

    <a
      href="/agent/setting"
      id="header-settings-link"
      class="text-muted-foreground transition-colors hover:text-foreground"
      aria-label={settingsLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <path d="M20 7h-9"></path>
        <path d="M14 17H5"></path>
        <circle cx="17" cy="17" r="3"></circle>
        <circle cx="7" cy="7" r="3"></circle>
      </svg>
    </a>
  </div>
</header>
