---
import { getLocale, getMessages } from "@/lib/i18n";

interface Props {
  href?: string;
}

const locale = getLocale(Astro);
const m = getMessages(locale);

const { href = "/agent" } = Astro.props;
---

<a
  id="announcement-banner"
  href={href}
  class="announcement-banner group/announcement pointer-events-none fixed inset-x-0 top-0 z-60 flex h-(--announcement-banner-height) items-center justify-center overflow-hidden border-b border-border bg-background/88 shadow-[0_1px_0_color-mix(in_oklch,var(--foreground)_4%,transparent)] backdrop-blur-md no-underline transition-[transform,opacity] duration-300 ease-out"
  data-cursor="focus"
  data-cursor-label="AI Studio"
>
  <div class="pointer-events-auto flex items-center gap-3">
    <span
      class="size-1.5 shrink-0 rounded-full bg-accent pulse-soft"
      aria-hidden="true"></span>

    <span class="flex items-center gap-1">
      <span
        class="hidden text-center font-mono text-[0.625rem] font-medium tracking-[0.16em] text-foreground uppercase sm:inline"
      >
        {m.announcement.text}
      </span>
      <span
        class="text-center font-mono text-[0.625rem] font-medium tracking-[0.16em] text-foreground uppercase sm:hidden"
      >
        {m.announcement.textMobile}
      </span>

      <span
        class="flex size-4.5 shrink-0 items-center justify-center text-muted-foreground transition-colors duration-350 ease-cinematic group-hover/announcement:text-accent"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M10.2002 8.23951C10.4821 7.93608 10.9573 7.91863 11.2607 8.20045L14.7607 11.4504C14.9135 11.5923 15 11.7918 15 12.0003C15 12.2088 14.9135 12.4082 14.7607 12.5501L11.2607 15.8001C10.9573 16.0819 10.4821 16.0644 10.2002 15.761C9.91838 15.4575 9.93584 14.9823 10.2393 14.7004L13.1465 12.0003L10.2393 9.30006C9.93584 9.01819 9.91838 8.543 10.2002 8.23951Z"
            fill="currentColor"></path>
        </svg>
      </span>
    </span>
  </div>
</a>

<script>
  import { bindAnnouncementBanner } from "@/service/announcement.service";

  function initAnnouncementBanner() {
    bindAnnouncementBanner();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnnouncementBanner, {
      once: true,
    });
  } else {
    initAnnouncementBanner();
  }

  document.addEventListener("astro:page-load", initAnnouncementBanner);
</script>

<style is:global>
  :root {
    --announcement-banner-height: 3.125rem;
    --site-mobile-dock-offset: 1rem;
    --chat-layer: 70;
  }

  html.is-announcement-hidden #announcement-banner {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  html[data-has-announcement] #site-header {
    top: var(--announcement-banner-height);
    transition: top 0.3s ease;
  }

  html[data-has-announcement].is-announcement-hidden #site-header {
    top: 0;
  }

  html[data-has-announcement] main.pt-28 {
    padding-top: calc(7rem + var(--announcement-banner-height));
  }

  @media (prefers-reduced-motion: reduce) {
    html.is-announcement-hidden #announcement-banner,
    html[data-has-announcement] #site-header {
      transition: none;
    }
  }
</style>
