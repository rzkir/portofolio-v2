---
import Layout from "@/layouts/Layout.astro";
import Aside from "@/components/ui/aside.astro";
import Canvas from "@/components/ui/canvas.astro";
import Card from "@/components/ui/card.astro";
import History from "@/components/ui/history.astro";
import AgentHeader from "@/layouts/agent-header.astro";
import Textarea from "@/components/ui/textarea.astro";
import {
  getAgentCategoryCards,
  getAgentStudio,
  type AgentStudioCategoryKey,
} from "@/lib/agent-content";
import { getLocale } from "@/lib/i18n";

interface Props {
  categoryKey: AgentStudioCategoryKey;
  showCanvas?: boolean;
}

const { categoryKey, showCanvas = false } = Astro.props;
const locale = getLocale(Astro);
const studio = getAgentStudio(locale);
const page = studio.categories[categoryKey];
const cards = getAgentCategoryCards(locale, categoryKey);
const { common } = studio;
const canvasLabels = {
  label: studio.canvas.label,
  webPreview: studio.canvas.webPreview,
  fullPreview: studio.canvas.fullPreview,
  live: studio.canvas.live,
  expand: studio.canvas.expand,
  refresh: studio.canvas.refresh,
  details: studio.canvas.details,
  previewTab: studio.canvas.previewTab,
  codeTab: studio.canvas.codeTab,
  copy: common.copy,
};
---

<Layout title={page.meta.title} description={page.meta.description} noIndex={true}>
  <Aside homeHref="/agent" />

  <main
    id="agent-main"
    class="relative flex min-w-0 flex-1 overflow-hidden md:flex-row"
  >
    <History
      storageKey={page.storageKey}
      title={common.historyTitle}
      newChatLabel={common.newChat}
      searchPlaceholder={common.searchPlaceholder}
      openLabel={common.openHistory}
      collapseLabel={common.collapseHistory}
      closeLabel={common.closeHistory}
      panelLabel={common.historyPanelLabel}
      emptyTitle={common.noHistory}
      emptyDescription={common.noHistoryDescription}
      emptySearchTitle={common.noSearchResults}
      emptySearchDescription={common.noSearchResultsDescription}
    />

    <div
      class="agent-chat-pane relative flex min-w-0 flex-1 flex-col overflow-hidden"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div
          class="absolute top-[-20%] right-[-10%] size-[50%] rounded-full bg-accent/5 blur-[120px]"
        >
        </div>
        <div
          class="absolute bottom-[-20%] left-[-10%] size-[50%] rounded-full bg-foreground/5 blur-[120px]"
        >
        </div>
      </div>

      <AgentHeader
        title={page.header}
        showHistory={true}
        openHistoryLabel={common.openConversationHistory}
        settingsLabel={common.settings}
        backHomeLabel={common.backHome}
      />

      <div class="agent-chat-body">
        <div
          id="agent-messages"
          class="agent-scrollbar relative min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 py-12 md:px-12"
        >
          <div id="agent-thread" class="mx-auto max-w-7xl space-y-16">
            <div class="py-20 text-center" id="agent-empty-state">
              <h2
                class="mb-6 font-display text-5xl font-light opacity-80 italic md:text-6xl"
              >
                {page.hero.line1} <br />
                <span class="font-bold text-foreground not-italic"
                  >{page.hero.line2}</span
                >
              </h2>
              <p class="text-lg font-light text-muted-foreground">
                {page.hero.subtitle}
              </p>

              <div
                id="agent-category-cards"
                class="agent-category-cards mx-auto mt-12 max-w-7xl text-left"
              >
                <ul class="agent-category-cards__list">
                  {
                    cards.map((item) => (
                      <li>
                        <Card
                          variant="select"
                          title={item.title}
                          categoryLabel={item.categoryLabel}
                          description={item.description}
                          category={item.category}
                          prompt={item.prompt}
                        />
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="agent-prompt-dock shrink-0 px-6 pt-4 pb-4 md:px-12">
        <div class="mx-auto max-w-7xl">
          <p
            id="agent-error"
            class="mb-3 hidden rounded-2xl border border-destructive/30 bg-destructive/10 px-4 py-3 text-sm text-destructive"
            role="alert"
            aria-live="polite"
          >
          </p>
          <form id="agent-prompt-form">
            <input type="hidden" name="category" value={page.category} />
            <Textarea
              variant="prompt"
              id="main-prompt-input"
              name="message"
              label={page.promptPlaceholder}
              required
            />
          </form>
        </div>
      </div>
    </div>
  </main>

  {showCanvas ? <Canvas labels={canvasLabels} /> : null}
</Layout>

<style>
  .agent-category-cards__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .agent-category-cards__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
