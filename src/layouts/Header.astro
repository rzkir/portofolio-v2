---
import LangSwitcher from "@/components/LangSwitcher.astro";
import ThemeSwitch from "@/components/ui/switch.astro";
import { cn } from "@/lib/utiles";
import { getLocale, getMessages } from "@/lib/i18n";

const locale = getLocale(Astro);
const m = getMessages(locale);

const navItems = [
  { index: "00", href: "/", label: m.nav.home },
  { index: "01", href: "/works", label: m.nav.works },
  { index: "02", href: "/blog", label: m.nav.blog },
  { index: "03", href: "/layanan", label: m.nav.services },
  { index: "04", href: "/achievements", label: m.nav.achievements },
  { index: "05", href: "/guest-notes", label: m.nav.guestNotes },
];

const currentPath = Astro.url.pathname;

function isNavActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const navLinkActive =
  "text-accent group-[.is-inverse]/site-header:text-background";

const desktopNavPillClass = cn(
  "relative m-0 flex list-none items-center gap-0.5 rounded-full border border-border bg-surface/55 p-0.5",
  "group-[.is-inverse]/site-header:border-background/18 group-[.is-inverse]/site-header:bg-background/8",
);

const shellClass = cn(
  "pointer-events-auto transition-[background-color,box-shadow,backdrop-filter] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]",
  "group-[.is-scrolled]/site-header:bg-background/88 group-[.is-scrolled]/site-header:backdrop-blur-md",
  "group-[.is-scrolled]/site-header:shadow-[0_1px_0_color-mix(in_oklch,var(--foreground)_4%,transparent)]",
  "group-[.is-inverse]/site-header:bg-transparent group-[.is-inverse]/site-header:shadow-none group-[.is-inverse]/site-header:backdrop-blur-none",
  "group-[.is-inverse.is-scrolled]/site-header:bg-accent/92 group-[.is-inverse.is-scrolled]/site-header:backdrop-blur-md",
);

const inverseText = "group-[.is-inverse]/site-header:text-background";
const inverseMuted = "group-[.is-inverse]/site-header:text-background/58";

const menuToggleClass = cn(
  "inline-flex items-center gap-2 rounded-full border border-border bg-surface/55 px-2.5 py-1.5 xl:hidden",
  "transition-colors duration-350 ease-cinematic",
  inverseText,
  "group-[.is-inverse]/site-header:border-background/18 group-[.is-inverse]/site-header:bg-background/8",
);
---

<header
  id="site-header"
  class="group/site-header pointer-events-none fixed inset-x-0 z-50"
>
  <div class={shellClass}>
    <div class="mx-auto container px-4 md:px-6">
      <div
        class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-4 py-4 sm:gap-x-4 xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] xl:gap-x-6 xl:py-5"
      >
        <a
          href="/"
          data-cursor="focus"
          data-cursor-label="Home"
          class={cn(
            "site-header__brand group/brand animate-focus flex min-w-0 flex-col gap-0.5 no-underline",
            inverseText,
          )}
        >
          <span
            class={cn(
              "font-display text-[clamp(1.35rem,2vw,1.75rem)] leading-none whitespace-nowrap italic transition-colors duration-350 ease-cinematic",
              "group-hover/brand:text-accent",
              "group-[.is-inverse]/site-header:group-hover/brand:text-foreground",
            )}
          >
            R. Ramadhan
          </span>
          <span
            class={cn(
              "font-mono text-[0.5625rem] tracking-[0.18em] uppercase text-muted-foreground whitespace-nowrap transition-colors duration-350 ease-cinematic sm:tracking-[0.22em]",
              "group-hover/brand:text-accent/70",
              inverseMuted,
              "group-[.is-inverse]/site-header:group-hover/brand:text-foreground/65",
            )}
          >
            {m.brand.tagline}
          </span>
        </a>

        <nav
          class="site-header__nav animate-focus hidden [animation-delay:120ms] xl:block xl:justify-self-center"
          aria-label={m.nav.main}
        >
          <ul data-header-nav class={desktopNavPillClass}>
            <li
              data-header-nav-indicator
              aria-hidden="true"
              class={cn(
                "site-header__nav-indicator pointer-events-none absolute top-0 left-0 z-0 h-0 w-0 overflow-hidden rounded-full",
                "bg-foreground/6 group-[.is-inverse]/site-header:bg-background/12",
              )}
            >
            </li>
            {
              navItems.map((item) => (
                <li class="relative z-10 shrink-0">
                  <a
                    href={item.href}
                    data-header-nav-link
                    data-cursor="focus"
                    data-cursor-label="Go"
                    aria-current={isNavActive(item.href) ? "page" : undefined}
                    class={cn(
                      "relative z-10 inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[0.625rem] font-medium tracking-[0.16em] uppercase no-underline",
                      "transition-colors duration-350 ease-cinematic",
                      "hover:text-accent focus-visible:text-accent",
                      inverseText,
                      "group-[.is-inverse]/site-header:hover:text-background",
                      "group-[.is-inverse]/site-header:focus-visible:text-background",
                      isNavActive(item.href) && navLinkActive,
                    )}
                  >
                    <span
                      class={cn(
                        "font-mono text-[0.5625rem] tracking-[0.14em] text-accent/75",
                        "group-[.is-inverse]/site-header:text-background/72",
                      )}
                    >
                      {item.index}
                    </span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div
          class="site-header__actions animate-focus flex [animation-delay:200ms] items-center justify-end gap-2 sm:gap-3 xl:justify-self-end"
        >
          <ThemeSwitch />
          <LangSwitcher />
          <button
            type="button"
            data-header-menu-toggle
            aria-expanded="false"
            aria-controls="site-header-menu"
            aria-label={m.nav.openMenu}
            data-label-open={m.nav.openMenu}
            data-label-close={m.nav.closeMenu}
            class={menuToggleClass}
          >
            <span class="font-mono text-[0.5625rem] tracking-[0.2em] uppercase">
              {m.nav.menu}
            </span>
            <span class="relative h-[0.55rem] w-3.5" aria-hidden="true">
              <span
                class="absolute top-0 left-0 h-px w-full rounded-full bg-current transition-transform duration-350 ease-cinematic group-[.is-menu-open]/site-header:top-1/2 group-[.is-menu-open]/site-header:-translate-y-1/2 group-[.is-menu-open]/site-header:rotate-45"
              ></span>
              <span
                class="absolute bottom-0 left-0 h-px w-full rounded-full bg-current transition-transform duration-350 ease-cinematic group-[.is-menu-open]/site-header:bottom-1/2 group-[.is-menu-open]/site-header:translate-y-1/2 group-[.is-menu-open]/site-header:-rotate-45"
              ></span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <nav
      id="site-header-menu"
      data-header-menu
      aria-label={m.nav.mobile}
      aria-hidden="true"
      class={cn(
        "pointer-events-auto overflow-hidden max-h-0 border-b border-transparent transition-[max-height,border-color,background-color,backdrop-filter] duration-500 ease-cinematic xl:hidden",
        "group-[.is-menu-open]/site-header:max-h-[min(32rem,80dvh)] group-[.is-menu-open]/site-header:border-border group-[.is-menu-open]/site-header:bg-background/94 group-[.is-menu-open]/site-header:backdrop-blur-md",
        "group-[.is-inverse.is-menu-open]/site-header:border-background/12 group-[.is-inverse.is-menu-open]/site-header:bg-accent/96",
      )}
    >
      <div class="mx-auto container px-4 md:px-6">
        <ul class="m-0 list-none overflow-y-auto pt-2 pb-5">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-header-menu-link
                  aria-current={isNavActive(item.href) ? "page" : undefined}
                  class={cn(
                    "grid grid-cols-[2.5rem_1fr] items-baseline gap-3 border-b border-border py-3.5 no-underline transition-colors duration-350 ease-cinematic",
                    inverseText,
                    "hover:text-accent",
                    "group-[.is-inverse]/site-header:hover:text-background",
                    isNavActive(item.href) && "text-accent",
                    isNavActive(item.href) &&
                      "group-[.is-inverse]/site-header:text-background",
                  )}
                >
                  <span
                    class={cn(
                      "font-mono text-[0.625rem] tracking-[0.16em] text-accent",
                      "group-[.is-inverse]/site-header:text-background/72",
                    )}
                  >
                    {item.index}
                  </span>
                  <span class="font-display text-[1.75rem] leading-none italic">
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  import { bindSiteHeader } from "@/service/header.service";

  function initSiteHeader() {
    bindSiteHeader();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSiteHeader, {
      once: true,
    });
  } else {
    initSiteHeader();
  }

  document.addEventListener("astro:page-load", initSiteHeader);
</script>

<style is:global>
  #site-header {
    top: 0;
  }

  @keyframes site-header-indicator-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .site-header__nav-indicator {
    opacity: 0;
    animation: site-header-indicator-in 0.55s var(--ease-cinematic) 680ms both;
    transition:
      transform 0.45s var(--ease-cinematic),
      width 0.45s var(--ease-cinematic),
      height 0.45s var(--ease-cinematic);
    will-change: transform, width, height;
  }

  .site-header__nav-indicator.is-visible {
    opacity: 1;
  }

  html.splash-pending .site-header__nav-indicator {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__nav-indicator {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
