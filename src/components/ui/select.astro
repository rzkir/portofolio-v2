---
import { cn } from "@/lib/utiles";

const {
  label,
  id,
  name,
  options,
  required = false,
  class: className,
  selectClass,
} = Astro.props;

const fieldClass =
  "w-full cursor-pointer border-b border-border bg-transparent py-2 outline-none transition-colors focus:border-accent";
---

<label class={cn("block", className)}>
  <span
    class="mb-2 block font-mono text-[10px] tracking-[0.2em] text-muted-foreground uppercase"
  >
    {label}
  </span>
  <select
    id={id}
    name={name}
    required={required}
    class={cn(fieldClass, selectClass)}
  >
    {
      options.map((option: SelectOption) => (
        <option value={option.value} selected={option.selected}>
          {option.label}
        </option>
      ))
    }
  </select>
</label>
