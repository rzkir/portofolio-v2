---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="hover-card group relative inline-flex items-center justify-center overflow-visible">
  <slot />
  <span
    class="pointer-events-none invisible absolute top-1/2 left-[calc(100%+0.5rem)] z-999 -translate-y-1/2 whitespace-nowrap rounded-md border border-border bg-background/95 px-2 py-1 text-xs text-foreground opacity-0 shadow-lg backdrop-blur-sm transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
    role="tooltip"
  >
    {label}
  </span>
</div>
