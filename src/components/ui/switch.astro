---
import { cn } from "@/lib/utiles";
import { getLocale, getMessages } from "@/lib/i18n";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const locale = getLocale(Astro);
const m = getMessages(locale);

const options = [
  { value: "light", label: m.theme.light },
  { value: "dark", label: m.theme.dark },
  { value: "system", label: m.theme.system },
] as const;

const triggerClass = cn(
  "theme-switch__trigger inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border bg-surface/55 px-2.5 py-1.5 font-mono text-[0.5625rem] tracking-[0.14em] text-muted-foreground uppercase transition-colors duration-350 ease-[cubic-bezier(0.32,0.72,0,1)]",
  "hover:text-foreground focus-visible:text-foreground",
  // Match header nav pill / nav links on inverse sections
  "group-[.is-inverse]/site-header:border-background/25 group-[.is-inverse]/site-header:bg-background/12",
  "group-[.is-inverse]/site-header:text-background group-[.is-inverse]/site-header:hover:text-background",
  "dark:group-[.is-inverse]/site-header:border-foreground/25 dark:group-[.is-inverse]/site-header:bg-foreground/10",
  "dark:group-[.is-inverse]/site-header:text-foreground dark:group-[.is-inverse]/site-header:hover:text-foreground",
);

const menuClass = cn(
  "theme-switch__menu absolute top-[calc(100%+0.45rem)] right-0 z-50 hidden min-w-[9.5rem] rounded-xl border border-border bg-background/95 p-1 text-foreground shadow-[0_10px_40px_color-mix(in_oklch,var(--foreground)_10%,transparent)] backdrop-blur-md",
);

const optionClass = cn(
  "theme-switch__option flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-left font-mono text-[0.5625rem] tracking-[0.14em] text-muted-foreground uppercase transition-colors duration-350 ease-[cubic-bezier(0.32,0.72,0,1)]",
  "hover:bg-foreground/6 hover:text-foreground",
);
---

<div
  class={cn("theme-switch relative", className)}
  data-theme-switch
>
  <button
    type="button"
    class={triggerClass}
    data-theme-trigger
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={m.theme.label}
  >
    <span class="theme-switch__trigger-icon flex size-4 items-center justify-center" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-3.5"
      >
        <rect width="20" height="14" x="2" y="3" rx="2"></rect>
        <path d="M8 21h8"></path>
        <path d="M12 17v4"></path>
      </svg>
    </span>
    <span class="theme-switch__trigger-label hidden sm:inline">{m.theme.system}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-3 opacity-70"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class={menuClass} data-theme-menu role="listbox" aria-label={m.theme.label} hidden>
    {
      options.map((option) => (
        <button
          type="button"
          class={optionClass}
          role="option"
          data-theme-option={option.value}
          aria-selected={option.value === "system" ? "true" : "false"}
        >
          {option.value === "light" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5 shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          )}
          {option.value === "dark" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5 shrink-0"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          )}
          {option.value === "system" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-3.5 shrink-0"
              aria-hidden="true"
            >
              <rect width="20" height="14" x="2" y="3" rx="2"></rect>
              <path d="M8 21h8"></path>
              <path d="M12 17v4"></path>
            </svg>
          )}
          <span>{option.label}</span>
        </button>
      ))
    }
  </div>
</div>

<style>
  .theme-switch__menu[hidden] {
    display: none;
  }

  .theme-switch__menu:not([hidden]) {
    display: block;
  }

  .theme-switch__option {
    border: 0;
    cursor: pointer;
    background: transparent;
  }

  .theme-switch__option.is-active {
    color: var(--foreground);
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
  }
</style>
