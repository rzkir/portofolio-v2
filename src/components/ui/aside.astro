---
import Sidebar from "@/components/ui/sidebar.astro";
import { getAgentSidebarItems } from "@/lib/agent-content";
import { getLocale, getMessages } from "@/lib/i18n";
import { cn } from "@/lib/utiles";

const locale = getLocale(Astro);
const studio = getAgentSidebarItems(locale);
const { common } = getMessages(locale).agentStudio;

const { class: className, homeHref } = Astro.props as AsideProps;
---

<button
  type="button"
  id="agent-sidebar-toggle"
  class="agent-sidebar-toggle fixed top-3 left-4 flex size-10 items-center justify-center rounded-xl border border-border bg-surface/95 text-foreground shadow-lg backdrop-blur-md transition-colors hover:bg-surface md:hidden"
  aria-label={common.openNavigation}
  aria-controls="agent-sidebar"
  aria-expanded="false"
  data-open-label={common.openNavigation}
  data-close-label={common.closeNavigation}
>
  <svg
    class="agent-sidebar-toggle__open size-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 6h16"></path>
    <path d="M4 12h16"></path>
    <path d="M4 18h16"></path>
  </svg>
  <svg
    class="agent-sidebar-toggle__close hidden size-5"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 6 6 18"></path>
    <path d="m6 6 12 12"></path>
  </svg>
</button>

<div
  id="agent-sidebar-backdrop"
  class="agent-sidebar-backdrop pointer-events-none fixed inset-0 bg-background/60 opacity-0 transition-opacity duration-200 md:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="agent-sidebar"
  class={cn(
    "agent-sidebar fixed inset-y-0 left-0 isolate flex w-20 -translate-x-full flex-col overflow-visible border-r border-border bg-surface py-8 transition-transform duration-200 ease-out md:static md:z-50 md:w-20 md:shrink-0 md:translate-x-0",
    className,
  )}
>
  <slot>
    <Sidebar homeHref={homeHref} items={studio} labels={common} />
  </slot>
</aside>

<script>
  import { bindAgentSidebar } from "@/lib/agent-sidebar.client";

  bindAgentSidebar();
  document.addEventListener("astro:page-load", () => bindAgentSidebar());
</script>
