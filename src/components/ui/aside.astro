---
import Sidebar from "@/components/ui/sidebar.astro";
import { cn } from "@/lib/utiles";

interface Props {
  class?: string;
  homeHref?: string;
}

const { class: className, homeHref } = Astro.props;
---

<aside
  class={cn(
    "relative z-50 isolate flex w-20 shrink-0 flex-col overflow-visible border-r border-border bg-surface py-8",
    className,
  )}
>
  <slot>
    <Sidebar homeHref={homeHref} />
  </slot>
</aside>
