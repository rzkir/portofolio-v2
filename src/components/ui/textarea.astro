---
import { cn } from "@/lib/utiles";

const {
  label,
  id,
  name,
  placeholder,
  maxlength,
  rows = 4,
  required = false,
  class: className,
  textareaClass,
  variant = "default",
  sendLabel = "Send prompt",
} = Astro.props;

const fieldClass =
  "w-full resize-none border-b border-border bg-transparent py-2 outline-none transition-colors focus:border-accent";
---

{
  variant === "chat" ? (
    <div class={cn("chat-prompt flex items-end gap-2", className)}>
      <div class="relative min-w-0 flex-1">
        <label class="sr-only" for={id}>
          {label}
        </label>
        <textarea
          id={id}
          name={name}
          rows={1}
          placeholder={label}
          maxlength={maxlength}
          required={required}
          autocomplete="off"
          class={cn(
            "chat-prompt__input block w-full max-h-32 resize-none overflow-y-hidden rounded-2xl border-none bg-muted py-3.5 px-4 text-sm leading-normal text-foreground ring-1 ring-border transition-[box-shadow] placeholder:text-muted-foreground focus:ring-2 focus:ring-foreground focus:outline-none",
            textareaClass,
          )}
        />
      </div>
      <button
        type="submit"
        id={`${id}-send`}
        class="chat-prompt__send flex size-12 shrink-0 items-center justify-center rounded-2xl bg-foreground text-background shadow-lg transition-colors hover:opacity-90"
        aria-label={sendLabel}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-5 translate-x-px"
          aria-hidden="true"
        >
          <path d="m22 2-7 20-4-9-9-4Z" />
          <path d="M22 2 11 13" />
        </svg>
      </button>
    </div>
  ) : variant === "prompt" ? (
    <div class={cn("agent-prompt group relative", className)}>
      <div class="agent-prompt__shell relative p-1 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
        <textarea
          id={id}
          name={name}
          rows={1}
          placeholder=" "
          maxlength={maxlength}
          required={required}
          autocomplete="off"
          class={cn(
            "agent-prompt__input relative z-10 block w-full min-h-14 max-h-48 resize-none overflow-y-hidden rounded-[1.75rem] border border-border/30 bg-background py-4 pr-20 pl-6 text-lg leading-relaxed font-light transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] placeholder:opacity-0 focus:border-accent/50 focus:bg-background focus:outline-none focus:shadow-[0_0_40px_color-mix(in_oklch,var(--accent)_15%,transparent)]",
            textareaClass,
          )}
        />

        <label
          for={id}
          class="agent-prompt__label pointer-events-none absolute left-6 z-20 origin-left bg-background px-2.5 py-0.5 text-lg font-light text-muted-foreground transition-all duration-400 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
        >
          {label}
        </label>

        <button
          type="submit"
          id={`${id}-send`}
          class="agent-prompt__send absolute right-4 bottom-3 z-20 flex size-14 scale-90 items-center justify-center rounded-full bg-foreground text-background opacity-0 shadow-xl transition-all duration-300 hover:bg-accent hover:text-accent-foreground"
          aria-label={sendLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6"
            aria-hidden="true"
          >
            <path d="m5 12 7-7 7 7" />
            <path d="M12 19V5" />
          </svg>
        </button>
      </div>
    </div>
  ) : (
    <label class={cn("block", className)}>
      <span class="mb-2 flex items-center justify-between font-mono text-[10px] tracking-[0.2em] text-muted-foreground uppercase">
        <span>{label}</span>
        <slot name="label-extra" />
      </span>
      <textarea
        id={id}
        name={name}
        placeholder={placeholder}
        maxlength={maxlength}
        rows={rows}
        required={required}
        class={cn(fieldClass, textareaClass)}
      />
    </label>
  )
}

<script>
  const PROMPT_MAX_HEIGHT = 192;
  const CHAT_MAX_HEIGHT = 128;

  function isChatInput(field: HTMLTextAreaElement) {
    return field.classList.contains("chat-prompt__input");
  }

  function resizeField(field: HTMLTextAreaElement) {
    const maxHeight = isChatInput(field) ? CHAT_MAX_HEIGHT : PROMPT_MAX_HEIGHT;

    field.style.height = "0px";
    const nextHeight = Math.min(Math.max(field.scrollHeight, 0), maxHeight);
    field.style.height = field.value ? `${nextHeight}px` : "";
    field.style.overflowY = field.scrollHeight > maxHeight ? "auto" : "hidden";
  }

  function bindAutoResizeField(field: HTMLTextAreaElement) {
    if (field.dataset.bound === "true") return;
    field.dataset.bound = "true";

    const shell = field.closest(".agent-prompt__shell");

    field.addEventListener("input", () => resizeField(field));
    field.addEventListener("focus", () => {
      if (field.value) resizeField(field);
    });
    field.addEventListener("blur", () => {
      if (!field.value.trim()) {
        field.style.height = "";
        field.style.overflowY = "hidden";
      }
    });
    field.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.shiftKey) return;
      event.preventDefault();
      field.closest("form")?.requestSubmit();
    });

    shell?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || target.closest("button")) return;
      field.focus();
    });
  }

  function bindPromptTextareas(root: ParentNode = document) {
    root
      .querySelectorAll<HTMLTextAreaElement>(
        ".agent-prompt__input, .chat-prompt__input",
      )
      .forEach(bindAutoResizeField);
  }

  bindPromptTextareas();
  document.addEventListener("astro:page-load", () => bindPromptTextareas());
</script>

<style>
  .agent-prompt__shell {
    overflow: visible;
    cursor: text;
  }

  .agent-prompt__shell button {
    cursor: pointer;
  }

  .agent-prompt__shell:has(.agent-prompt__input:focus) {
    padding: 0.5rem;
  }

  .agent-prompt__input {
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--accent) 35%, transparent)
      transparent;
  }

  .agent-prompt__label {
    top: 50%;
    transform: translateY(-50%);
  }

  .agent-prompt__input:focus ~ .agent-prompt__label {
    top: 1.25rem;
    transform: translate(-0.5rem, -100%) scale(0.82);
    opacity: 1;
  }

  .agent-prompt__input:not(:placeholder-shown):not(:focus) ~ .agent-prompt__label {
    opacity: 0;
  }

  .agent-prompt__input:focus ~ .agent-prompt__send {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(
      0 0 15px color-mix(in oklch, var(--accent) 40%, transparent)
    );
  }

  .chat-prompt__input {
    field-sizing: content;
    min-height: 3rem;
    height: auto;
  }
</style>
