---
import { cn } from "@/lib/utiles";

export interface TextareaProps {
  label: string;
  id: string;
  name: string;
  placeholder?: string;
  maxlength?: number;
  rows?: number;
  required?: boolean;
  class?: string;
  textareaClass?: string;
  variant?: "default" | "prompt";
  attachLabel?: string;
  sendLabel?: string;
  footerHints?: string[];
}

const {
  label,
  id,
  name,
  placeholder,
  maxlength,
  rows = 4,
  required = false,
  class: className,
  textareaClass,
  variant = "default",
  attachLabel = "Attach file",
  sendLabel = "Send prompt",
  footerHints = ["Neural Context: Enabled", "Privacy Mode: Active"],
} = Astro.props;

const fieldClass =
  "w-full resize-none border-b border-border bg-transparent py-2 outline-none transition-colors focus:border-accent";
---

{
  variant === "prompt" ? (
    <div class={cn("agent-prompt group relative", className)}>
      <div class="agent-prompt__shell relative flex items-center p-1 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] focus-within:p-2">
        <div class="absolute left-4 flex gap-2">
          <button
            type="button"
            class="flex size-10 items-center justify-center rounded-full text-muted-foreground transition-all hover:bg-foreground/5 hover:text-foreground"
            aria-label={attachLabel}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
          </button>
        </div>

        <input
          type="text"
          id={id}
          name={name}
          placeholder=" "
          maxlength={maxlength}
          required={required}
          autocomplete="off"
          class={cn(
            "agent-prompt__input relative z-10 w-full rounded-full border border-border/30 bg-background py-6 pr-20 pl-16 text-lg font-light transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] placeholder:opacity-0 focus:border-accent/50 focus:bg-background focus:outline-none focus:shadow-[0_0_40px_color-mix(in_oklch,var(--accent)_15%,transparent)]",
            textareaClass,
          )}
        />

        <label
          for={id}
          class="agent-prompt__label pointer-events-none absolute left-16 z-20 text-lg font-light text-muted-foreground transition-all duration-400 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
        >
          {label}
        </label>

        <button
          type="submit"
          id={`${id}-send`}
          class="agent-prompt__send absolute right-4 z-20 flex size-14 scale-90 items-center justify-center rounded-full bg-foreground text-background opacity-0 shadow-xl transition-all duration-300 hover:bg-accent hover:text-accent-foreground"
          aria-label={sendLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6"
            aria-hidden="true"
          >
            <path d="m5 12 7-7 7 7" />
            <path d="M12 19V5" />
          </svg>
        </button>
      </div>

      <div class="mt-6 flex justify-center gap-8">
        {
          footerHints.map((hint: string) => (
            <span class="font-mono text-[9px] font-bold tracking-[0.3em] text-muted-foreground/40 uppercase">
              {hint}
            </span>
          ))
        }
      </div>
    </div>
  ) : (
    <label class={cn("block", className)}>
      <span class="mb-2 flex items-center justify-between font-mono text-[10px] tracking-[0.2em] text-muted-foreground uppercase">
        <span>{label}</span>
        <slot name="label-extra" />
      </span>
      <textarea
        id={id}
        name={name}
        placeholder={placeholder}
        maxlength={maxlength}
        rows={rows}
        required={required}
        class={cn(fieldClass, textareaClass)}
      />
    </label>
  )
}

<style>
  .agent-prompt__shell {
    overflow: visible;
  }

  .agent-prompt__input:focus ~ .agent-prompt__label,
  .agent-prompt__input:not(:placeholder-shown) ~ .agent-prompt__label {
    transform: translate(-10px, -32px) scale(0.85);
    opacity: 1;
    color: var(--accent);
  }

  .agent-prompt__input:focus ~ .agent-prompt__send,
  .agent-prompt__input:not(:placeholder-shown) ~ .agent-prompt__send {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(0 0 15px color-mix(in oklch, var(--accent) 40%, transparent));
  }
</style>
