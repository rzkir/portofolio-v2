---
import { cn } from "@/lib/utiles";
import Tabs from "@/components/ui/tabs.astro";
import PreviewDialog from "@/components/dialog/dialog.priview.astro";
import PreviewIcon from "@/components/svg/priview.astro";

interface Props {
  id?: string;
  class?: string;
  labels?: {
    label: string;
    webPreview: string;
    fullPreview: string;
    live: string;
    expand: string;
    refresh: string;
    details: string;
    previewTab: string;
    codeTab: string;
    copy: string;
    openCanvas?: string;
    collapseCanvas?: string;
    closeCanvas?: string;
    expandPreview?: string;
    copyActiveFile?: string;
  };
}

const {
  id = "agent-canvas",
  class: className,
  labels = {
    label: "Canvas",
    webPreview: "Web preview",
    fullPreview: "Full preview",
    live: "live",
    expand: "Expand",
    refresh: "Refresh",
    details: "Details",
    previewTab: "Preview",
    codeTab: "Code",
    copy: "Copy",
    openCanvas: "Open canvas",
    collapseCanvas: "Collapse canvas",
    closeCanvas: "Close canvas",
    expandPreview: "Open full preview",
    copyActiveFile: "Copy active file",
  },
} = Astro.props;
const tabsId = `${id}-tabs`;
---

<aside
  id={id}
  class={cn(
    "agent-canvas h-full w-full shrink-0 border-border bg-surface md:border-l",
    className,
  )}
  aria-label={labels.label}
  aria-hidden="true"
>
  <button
    type="button"
    id={`${id}-expand`}
    class="agent-panel-rail agent-canvas-rail"
    aria-label={labels.openCanvas}
    aria-expanded="false"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
    <span class="agent-panel-rail__label">{labels.label}</span>
  </button>

  <div class="agent-canvas__body flex min-h-0 flex-1 flex-col">
  <header
    class="flex h-20 shrink-0 items-center justify-between border-b border-border px-6"
  >
    <div>
      <p
        class="font-mono text-[10px] tracking-[0.3em] text-muted-foreground uppercase"
      >
        {labels.label}
      </p>
      <h2 class="font-display text-xl italic">{labels.webPreview}</h2>
    </div>
    <div class="flex items-center gap-1">
      <button
        type="button"
        id={`${id}-collapse`}
        class="hidden size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-foreground md:inline-flex"
        aria-label={labels.collapseCanvas}
        aria-expanded="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        id={`${id}-close`}
        class="flex size-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-foreground"
        aria-label={labels.closeCanvas}
      >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    </div>
  </header>

  <div
    class="flex shrink-0 items-center justify-between gap-3 border-b border-border px-6 py-3"
  >
    <span
      id={`${id}-language`}
      class="rounded-full border border-border px-3 py-1 font-mono text-[10px] tracking-widest text-accent uppercase"
    >
      {labels.live}
    </span>

    <div class="flex min-w-0 items-center gap-4 overflow-x-auto">
      <button
        type="button"
        id={`${id}-expand-preview`}
        data-dialog-open="agent-preview-dialog"
        class="flex items-center gap-2 font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
        aria-label="Open full preview"
      >
        <PreviewIcon class="size-4" />
        {labels.expand}
      </button>

      <button
        type="button"
        id={`${id}-refresh`}
        class="flex items-center gap-2 font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
          <path d="M12 7v5l4 2"></path>
        </svg>
        {labels.refresh}
      </button>

      <a
        id={`${id}-details`}
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="agent-canvas__details pointer-events-auto relative z-10 hidden shrink-0 items-center gap-2 font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
        aria-label="Open build details in a new tab"
        data-cursor="hover"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <path d="M15 3h6v6"></path>
          <path d="M10 14 21 3"></path>
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
          ></path>
        </svg>
        {labels.details}
      </a>

      <button
        type="button"
        id={`${id}-copy`}
        class="flex items-center gap-2 font-mono text-[10px] font-bold tracking-widest text-muted-foreground uppercase transition-colors hover:text-foreground"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
          aria-hidden="true"
        >
          <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
          <path
            d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
          ></path>
        </svg>
        {labels.copy}
      </button>
    </div>
  </div>

  <div class="flex min-h-0 flex-1 flex-col px-6 pb-6">
    <Tabs
      id={tabsId}
      tabs={[
        { id: "preview", label: labels.previewTab },
        { id: "code", label: labels.codeTab },
      ]}
      defaultTab="preview"
      class="min-h-0 flex-1"
      listClass="mb-4 shrink-0"
      panelsClass="min-h-0 flex-1"
    >
      <div
        id={`${id}-panel-preview`}
        role="tabpanel"
        aria-labelledby={`${tabsId}-tab-preview`}
        class="ui-tabs__panel"
        data-tab-panel="preview"
      >
        <div class="agent-canvas__viewport">
          <iframe
            id={`${id}-frame`}
            class="agent-canvas__frame rounded-xl border border-border bg-white"
            title="Live web preview"
            sandbox="allow-scripts allow-modals allow-forms allow-popups"
          ></iframe>
        </div>
      </div>

      <div
        id={`${id}-panel-code`}
        role="tabpanel"
        aria-labelledby={`${tabsId}-tab-code`}
        class="ui-tabs__panel ui-tabs__panel--hidden"
        data-tab-panel="code"
        hidden
      >
        <div
          id={`${id}-code-tabs`}
          class="agent-code-editor"
          data-ui-tabs
          data-tabs-variant="editor"
        >
          <div class="agent-code-editor__tabbar">
            <div
              class="agent-code-editor__tabs"
              role="tablist"
              aria-label="Source files"
            >
              <button
                type="button"
                role="tab"
                id={`${id}-code-tab-html`}
                class="agent-code-editor__tab is-active"
                data-tab-trigger="html"
                aria-selected="true"
                aria-controls={`${id}-code-panel-html`}
              >
                index.html
              </button>
              <button
                type="button"
                role="tab"
                id={`${id}-code-tab-css`}
                class="agent-code-editor__tab"
                data-tab-trigger="css"
                aria-selected="false"
                aria-controls={`${id}-code-panel-css`}
              >
                styles.css
              </button>
              <button
                type="button"
                role="tab"
                id={`${id}-code-tab-js`}
                class="agent-code-editor__tab"
                data-tab-trigger="js"
                aria-selected="false"
                aria-controls={`${id}-code-panel-js`}
              >
                script.js
              </button>
            </div>

            <button
              type="button"
              id={`${id}-code-copy`}
              class="agent-code-editor__copy"
              aria-label={labels.copyActiveFile}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3.5"
                aria-hidden="true"
              >
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
                <path
                  d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                ></path>
              </svg>
              <span data-code-copy-label>{labels.copy}</span>
            </button>
          </div>

          <div class="agent-code-editor__workspace">
            <div
              id={`${id}-code-panel-html`}
              role="tabpanel"
              aria-labelledby={`${id}-code-tab-html`}
              class="ui-tabs__panel agent-code-editor__panel"
              data-tab-panel="html"
            >
              <div class="agent-code-editor__surface">
                <div class="agent-code-editor__gutter" aria-hidden="true">
                  1
                </div>
                <pre
                  class="agent-code-editor__pre"><code id={`${id}-code-html`} class="agent-code-editor__code agent-code-editor__code--html" /></pre>
              </div>
            </div>

            <div
              id={`${id}-code-panel-css`}
              role="tabpanel"
              aria-labelledby={`${id}-code-tab-css`}
              class="ui-tabs__panel agent-code-editor__panel ui-tabs__panel--hidden"
              data-tab-panel="css"
              hidden
            >
              <div class="agent-code-editor__surface">
                <div class="agent-code-editor__gutter" aria-hidden="true">
                  1
                </div>
                <pre
                  class="agent-code-editor__pre"><code id={`${id}-code-css`} class="agent-code-editor__code agent-code-editor__code--css" /></pre>
              </div>
            </div>

            <div
              id={`${id}-code-panel-js`}
              role="tabpanel"
              aria-labelledby={`${id}-code-tab-js`}
              class="ui-tabs__panel agent-code-editor__panel ui-tabs__panel--hidden"
              data-tab-panel="js"
              hidden
            >
              <div class="agent-code-editor__surface">
                <div class="agent-code-editor__gutter" aria-hidden="true">
                  1
                </div>
                <pre
                  class="agent-code-editor__pre"><code id={`${id}-code-js`} class="agent-code-editor__code agent-code-editor__code--js" /></pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Tabs>
  </div>
  </div>
</aside>

<PreviewDialog />

<style is:global>
  .agent-canvas {
    display: none;
    position: relative;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .agent-canvas.is-open {
    display: flex;
  }

  @media (min-width: 768px) {
    .agent-canvas.is-open {
      width: 42%;
    }
  }

  .agent-canvas__viewport {
    display: flex;
    flex: 1 1 0%;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--accent) 30%, transparent)
      transparent;
  }

  .agent-canvas__frame {
    display: block;
    flex: 1 1 0%;
    width: 100%;
    min-height: 0;
    border: 0;
    color-scheme: light;
    background: #fff;
  }

  .agent-canvas__details {
    display: inline-flex;
  }

  .agent-code-editor {
    display: flex;
    flex: 1 1 0%;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: #1e1e1e;
  }

  .agent-code-editor__tabbar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid #2b2b2b;
    background: #252526;
  }

  .agent-code-editor__tabs {
    display: flex;
    align-items: flex-end;
    min-width: 0;
    flex: 1 1 auto;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .agent-code-editor__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.35rem 0.5rem 0.35rem 0;
    padding: 0.35rem 0.65rem;
    border: 1px solid #3c3c3c;
    border-radius: 0.35rem;
    background: #2d2d2d;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cccccc;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .agent-code-editor__copy:hover {
    color: #ffffff;
    background: #3c3c3c;
    border-color: #4f4f4f;
  }

  .agent-code-editor__copy.is-copied {
    color: #4ec9b0;
    border-color: #4ec9b0;
  }

  .agent-code-editor__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    border-right: 1px solid #2b2b2b;
    border-bottom: 2px solid transparent;
    background: #2d2d2d;
    padding: 0.65rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #969696;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .agent-code-editor__tab:hover {
    color: #d4d4d4;
    background: #1f1f1f;
  }

  .agent-code-editor__tab.is-active {
    color: #ffffff;
    background: #1e1e1e;
    border-bottom-color: var(--accent);
  }

  .agent-code-editor__tab.is-hidden {
    display: none;
  }

  .agent-code-editor__workspace {
    display: flex;
    flex: 1 1 0%;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .agent-code-editor__panel {
    display: flex;
    flex: 1 1 0%;
    flex-direction: column;
    min-height: 0;
  }

  .agent-code-editor__surface {
    display: grid;
    grid-template-columns: auto 1fr;
    flex: 1 1 0%;
    min-height: 0;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: #424242 transparent;
  }

  .agent-code-editor__gutter {
    padding: 1rem 0.75rem 1rem 1rem;
    border-right: 1px solid #2b2b2b;
    background: #1e1e1e;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.6;
    text-align: right;
    color: #858585;
    user-select: none;
    white-space: pre;
  }

  .agent-code-editor__pre {
    margin: 0;
    padding: 1rem;
    overflow: visible;
    background: #1e1e1e;
  }

  .agent-code-editor__code {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: #d4d4d4;
    white-space: pre;
    tab-size: 2;
  }

  /* VS Code Dark+ token colors */
  .agent-code-editor__code .tok-comment {
    color: #6a9955;
  }

  .agent-code-editor__code .tok-keyword {
    color: #569cd6;
  }

  .agent-code-editor__code .tok-string {
    color: #ce9178;
  }

  .agent-code-editor__code .tok-number {
    color: #b5cea8;
  }

  .agent-code-editor__code .tok-function {
    color: #dcdcaa;
  }

  .agent-code-editor__code .tok-type {
    color: #4ec9b0;
  }

  .agent-code-editor__code .tok-tag {
    color: #569cd6;
  }

  .agent-code-editor__code .tok-tag-bracket {
    color: #808080;
  }

  .agent-code-editor__code .tok-attr {
    color: #9cdcfe;
  }

  .agent-code-editor__code .tok-property {
    color: #9cdcfe;
  }

  .agent-code-editor__code .tok-selector {
    color: #d7ba7d;
  }

  .agent-code-editor__code .tok-punct {
    color: #d4d4d4;
  }

  .agent-code-editor__code .tok-text {
    color: #d4d4d4;
  }
</style>
