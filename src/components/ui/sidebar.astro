---
import { cn } from "@/lib/utiles";
import { portrait } from "@/data/portfolio";
import HoverCard from "@/components/ui/hover-card.astro";

export interface SidebarNavItem {
  id: string;
  href: string;
  label: string;
  icon:
    | "chat"
    | "history"
    | "folder"
    | "seo"
    | "marketing"
    | "finance"
    | "health"
    | "trivia"
    | "academia"
    | "programming"
    | "technology"
    | "science"
    | "translation"
    | "legal";
  active?: boolean;
}

interface Props {
  class?: string;
  items?: SidebarNavItem[];
  homeHref?: string;
}

const {
  class: className,
  homeHref = "/agent",
  items = [
    {
      id: "chat",
      href: "/agent",
      label: "Chat",
      icon: "chat",
    },
    {
      id: "programming",
      href: "/agent/programming",
      label: "Programming",
      icon: "programming",
    },
    {
      id: "seo",
      href: "/agent/seo",
      label: "SEO",
      icon: "seo",
    },
    {
      id: "marketing",
      href: "/agent/marketing",
      label: "Marketing",
      icon: "marketing",
    },
    {
      id: "finance",
      href: "/agent/finance",
      label: "Finance",
      icon: "finance",
    },
    {
      id: "health",
      href: "/agent/health",
      label: "Health",
      icon: "health",
    },
    {
      id: "trivia",
      href: "/agent/trivia",
      label: "Trivia",
      icon: "trivia",
    },
    {
      id: "academia",
      href: "/agent/academia",
      label: "Academia",
      icon: "academia",
    },
    {
      id: "technology",
      href: "/agent/technology",
      label: "Technology",
      icon: "technology",
    },
    {
      id: "science",
      href: "/agent/science",
      label: "Science",
      icon: "science",
    },
    {
      id: "translation",
      href: "/agent/translation",
      label: "Translation",
      icon: "translation",
    },
    {
      id: "legal",
      href: "/agent/legal",
      label: "Legal",
      icon: "legal",
    },
  ],
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function normalizePath(path: string): string {
  return path.replace(/\/$/, "") || "/";
}

function isNavActive(href: string): boolean {
  if (!href || href === "#") return false;

  const normalizedHref = normalizePath(href);

  if (normalizedHref === "/agent") {
    return pathname === "/agent";
  }

  return (
    pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`)
  );
}

const navItems = items.map((item) => ({
  ...item,
  active: item.active ?? isNavActive(item.href),
}));

const iconClass = "size-6";
---

<div
  class={cn(
    "relative z-60 flex h-full min-h-0 flex-col items-center overflow-visible md:h-dvh",
    className,
  )}
>
  <a href={homeHref} class="group mb-8 cursor-pointer" aria-label="Home">
    <div
      class="flex size-12 items-center justify-center rounded-2xl bg-foreground transition-transform group-hover:rotate-12"
    >
      <span class="font-display text-2xl font-bold text-background">R</span>
    </div>
  </a>

  <nav
    class="flex min-h-0 w-full flex-1 overflow-visible"
    aria-label="Agent navigation"
  >
    <div
      class="sidebar-nav-scroll flex min-h-0 w-full flex-1 flex-col items-center gap-6 overflow-y-auto overscroll-contain lg:gap-8"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            id={`nav-${item.id}-link`}
            class={cn(
              "inline-flex w-full justify-center transition-colors",
              item.active
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground",
            )}
            aria-label={item.label}
            aria-current={item.active ? "page" : undefined}
          >
            <HoverCard label={item.label}>
              {item.icon === "chat" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                </svg>
              )}
              {item.icon === "programming" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="m16 18 6-6-6-6" />
                  <path d="m8 6-6 6 6 6" />
                </svg>
              )}
              {item.icon === "seo" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" />
                  <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                </svg>
              )}
              {item.icon === "marketing" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M3 11 18-5v12L3 14v-3z" />
                  <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
                </svg>
              )}
              {item.icon === "finance" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M3 3v18h18" />
                  <path d="m7 14 3-3 3 2 4-5" />
                  <circle cx="10" cy="11" r="1" />
                  <circle cx="13" cy="13" r="1" />
                  <circle cx="17" cy="8" r="1" />
                </svg>
              )}
              {item.icon === "health" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M12 21s-7-4.35-9-8.56C1.23 8.72 3.3 5 6.75 5c2.02 0 3.15 1.05 4.02 2.25C11.65 6.05 12.98 5 15 5c3.45 0 5.52 3.72 3.75 7.44C19 16.65 12 21 12 21z" />
                  <path d="M9 12h6" />
                  <path d="M12 9v6" />
                </svg>
              )}
              {item.icon === "trivia" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 16v.01" />
                  <path d="M9.5 9.5a2.5 2.5 0 1 1 4.2 1.8c-.8.7-1.2 1.1-1.2 2.2" />
                </svg>
              )}
              {item.icon === "academia" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M12 3 2 8l10 5 10-5-10-5Z" />
                  <path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5" />
                </svg>
              )}
              {item.icon === "technology" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                  <path d="m2 17 10 5 10-5" />
                  <path d="m2 12 10 5 10-5" />
                </svg>
              )}
              {item.icon === "science" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z" />
                  <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                </svg>
              )}
              {item.icon === "translation" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M4 5h9" />
                  <path d="M7 3v2a7 7 0 0 1-7 7" />
                  <path d="M9 16l3-8 3 8" />
                  <path d="M10.5 12h3" />
                  <path d="M14 20h6" />
                </svg>
              )}
              {item.icon === "legal" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M16 16.5 12 20l-4-3.5" />
                  <path d="M12 4v16" />
                  <path d="M4 7h16" />
                  <path d="M7 7a2.5 2.5 0 1 1-5 0" />
                  <path d="M22 7a2.5 2.5 0 1 1-5 0" />
                </svg>
              )}
              {item.icon === "history" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
                  <path d="M3 3v5h5" />
                  <path d="M12 7v5l4 2" />
                </svg>
              )}
              {item.icon === "folder" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                  aria-hidden="true"
                >
                  <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                  <path d="M2 10h20" />
                </svg>
              )}
            </HoverCard>
          </a>
        ))
      }
    </div>
  </nav>

  <div class="mt-6">
    <div class="size-10 rounded-full border border-accent/50 p-0.5">
      <img
        src={portrait.src}
        width={40}
        height={40}
        class="size-full rounded-full object-cover"
        alt="User"
      />
    </div>
  </div>
</div>

<style>
  .sidebar-nav-scroll {
    overflow-x: visible;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .sidebar-nav-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
