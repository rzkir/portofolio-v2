---
import ThemeSwitch from "@/components/ui/switch.astro";
import { cn } from "@/lib/utiles";

interface Props {
  title: string;
  version?: string;
  class?: string;
}

const { title, version = "v4", class: className } = Astro.props;
---

<header
  class={cn(
    "agent-header relative z-10 flex min-h-16 shrink-0 items-center justify-between gap-3 border-b border-border bg-background/80 py-3 pl-14 pr-4 backdrop-blur-md sm:min-h-20 sm:pr-6 md:pl-12 md:pr-12",
    className,
  )}
>
  <div class="min-w-0 flex-1">
    <h1
      class="truncate font-display text-lg font-light tracking-wide italic sm:text-2xl md:text-3xl"
    >
      {title}
      <span class="ml-1.5 font-bold text-accent not-italic sm:ml-2">{version}</span>
    </h1>
  </div>

  <div class="flex shrink-0 items-center gap-2 sm:gap-4 md:gap-6">
    <ThemeSwitch />

    <div
      class="agent-glass hidden items-center gap-2 rounded-full px-4 py-2 md:flex"
    >
      <span class="size-2 rounded-full bg-accent pulse-soft"></span>
      <span
        class="font-mono text-[10px] font-bold tracking-[0.2em] text-muted-foreground uppercase"
      >
        Neural Link Active
      </span>
    </div>

    <button
      type="button"
      id="header-share-btn"
      class="text-muted-foreground transition-colors hover:text-foreground"
      aria-label="Share conversation"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
        aria-hidden="true"
      >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
        <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
      </svg>
    </button>
  </div>
</header>
