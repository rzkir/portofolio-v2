---
import { cn } from "@/lib/utiles";

type Variant =
  | "primary"
  | "ghost"
  | "icon"
  | "outline"
  | "quick-reply"
  | "danger-ghost";
type Size = "sm" | "md" | "lg" | "icon";

const {
  type = "button",
  variant = "primary",
  size = "md",
  class: className,
  id,
  disabled = false,
  "aria-label": ariaLabel,
  "aria-expanded": ariaExpanded,
  "aria-haspopup": ariaHaspopup,
  "data-chat-action": dataChatAction,
  ...rest
} = Astro.props as ButtonProps & Record<string, unknown>;

const baseClass =
  "inline-flex items-center justify-center font-medium transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] disabled:pointer-events-none disabled:opacity-50";

const variantClass: Record<Variant, string> = {
  primary:
    "bg-accent text-accent-foreground shadow-md hover:brightness-110 active:scale-95",
  ghost:
    "text-muted-foreground hover:bg-foreground/8 hover:text-foreground",
  icon:
    "text-muted-foreground hover:bg-foreground/8 hover:text-foreground rounded-lg",
  outline:
    "border border-border bg-background text-foreground hover:border-accent/40 hover:text-accent",
  "quick-reply":
    "whitespace-nowrap rounded-full border border-border bg-background px-4 py-2 text-xs text-muted-foreground hover:border-accent hover:text-accent",
  "danger-ghost":
    "w-full justify-start gap-2 rounded-none px-4 py-2.5 text-left text-sm text-destructive hover:bg-destructive/8",
};

const sizeClass: Record<Size, string> = {
  sm: "rounded-lg px-3 py-1.5 text-xs",
  md: "rounded-lg px-4 py-2 text-sm",
  lg: "rounded-xl px-5 py-3 text-sm",
  icon: "size-10 rounded-lg p-2",
};
---

<button
  type={type}
  id={id}
  disabled={disabled}
  aria-label={ariaLabel}
  aria-expanded={ariaExpanded}
  aria-haspopup={ariaHaspopup}
  data-chat-action={dataChatAction}
  {...rest}
  class={cn(
    baseClass,
    variantClass[variant],
    variant === "quick-reply" || variant === "danger-ghost"
      ? ""
      : sizeClass[size],
    className,
  )}
>
  <slot />
</button>
