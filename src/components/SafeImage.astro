---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import ImageCorrupt from "@/components/ImageCorrupt.astro";
import { cn } from "@/lib/utiles";

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  class?: string;
  imgClass?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  width?: number;
  height?: number;
  dataSrc?: string;
}

const {
  src,
  alt = "",
  class: className,
  imgClass,
  loading = "lazy",
  decoding = "async",
  width,
  height,
  dataSrc,
} = Astro.props;

const isRemote = typeof src === "string";
---

<span class={cn("relative block w-full overflow-hidden", className)} data-safe-image>
  {
    isRemote ? (
      <img
        src={src}
        alt={alt}
        loading={loading}
        decoding={decoding}
        width={width}
        height={height}
        data-credential-src={dataSrc}
        data-safe-image-el
        class={imgClass}
      />
    ) : src ? (
      <Image
        src={src}
        alt={alt}
        data-safe-image-el
        class={imgClass}
      />
    ) : (
      <img
        alt={alt}
        loading={loading}
        decoding={decoding}
        width={width}
        height={height}
        data-credential-src={dataSrc}
        data-safe-image-el
        class={imgClass}
      />
    )
  }
  <span
    class="pointer-events-none absolute inset-0 z-[1] hidden size-full"
    data-safe-image-fallback
    hidden
  >
    <ImageCorrupt />
  </span>
</span>