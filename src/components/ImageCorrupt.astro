---
import { cn } from "@/lib/utiles";
import { getLocale, getMessages } from "@/lib/i18n";

interface Props {
  class?: string;
  label?: string;
}

const locale = getLocale(Astro);
const m = getMessages(locale);
const { class: className, label = m.common.imageCorrupt } = Astro.props;
---

<div
  class={cn("image-corrupt", className)}
  role="img"
  aria-label={label}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="image-corrupt__icon"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <circle cx="8.5" cy="10" r="1.25"></circle>
    <path d="m21 15-4.5-4.5L9 18"></path>
    <path d="M3 19 21 5"></path>
  </svg>
  <span class="image-corrupt__label">{label}</span>
</div>

<style>
  .image-corrupt {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.75rem;
    container-type: size;
    background-color: var(--surface);
    color: var(--muted-foreground);
  }

  .image-corrupt__icon {
    width: min(2rem, 40%);
    height: auto;
    max-height: 40%;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .image-corrupt__label {
    display: none;
    max-width: 90%;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
  }

  @container (min-width: 140px) and (min-height: 88px) {
    .image-corrupt__label {
      display: block;
    }
  }
</style>
