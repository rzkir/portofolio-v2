---
import LangFlag from "@/components/LangFlag.astro";
import { cn } from "@/lib/utiles";
import {
  getLocale,
  getMessages,
  langHref,
  LOCALES,
  type Locale,
} from "@/lib/i18n";

const locale = getLocale(Astro);
const m = getMessages(locale);
const { pathname, search } = Astro.url;

const langLabels: Record<Locale, string> = {
  id: m.lang.id,
  en: m.lang.en,
  ja: m.lang.ja,
};

const options = LOCALES.map((value) => ({
  value,
  label: langLabels[value],
}));

const currentLabel = langLabels[locale];

const triggerClass = cn(
  "lang-switch__trigger inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border bg-surface/55 px-2.5 py-1.5 font-mono text-[0.5625rem] tracking-[0.14em] text-muted-foreground uppercase transition-colors duration-350 ease-[cubic-bezier(0.32,0.72,0,1)]",
  "hover:text-foreground focus-visible:text-foreground",
  // Match header nav pill / nav links on inverse sections
  "group-[.is-inverse]/site-header:border-background/25 group-[.is-inverse]/site-header:bg-background/12",
  "group-[.is-inverse]/site-header:text-background group-[.is-inverse]/site-header:hover:text-background",
  "dark:group-[.is-inverse]/site-header:border-foreground/25 dark:group-[.is-inverse]/site-header:bg-foreground/10",
  "dark:group-[.is-inverse]/site-header:text-foreground dark:group-[.is-inverse]/site-header:hover:text-foreground",
);

const menuClass = cn(
  "lang-switch__menu absolute top-[calc(100%+0.45rem)] right-0 z-50 hidden min-w-[8.5rem] rounded-xl border border-border bg-background/95 p-1 text-foreground shadow-[0_10px_40px_color-mix(in_oklch,var(--foreground)_10%,transparent)] backdrop-blur-md",
);

const optionClass = cn(
  "lang-switch__option flex w-full items-center gap-2 rounded-lg px-2.5 py-2 font-mono text-[0.5625rem] tracking-[0.14em] text-muted-foreground uppercase no-underline transition-colors duration-350 ease-[cubic-bezier(0.32,0.72,0,1)]",
  "hover:bg-foreground/6 hover:text-foreground",
);
---

<div class="lang-switch relative site-header__lang" data-lang-switch>
  <button
    type="button"
    class={triggerClass}
    data-lang-trigger
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={m.lang.label}
  >
    <LangFlag locale={locale} />
    <span class="lang-switch__trigger-label hidden sm:inline">{currentLabel}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-3 opacity-70"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    class={menuClass}
    data-lang-menu
    role="listbox"
    aria-label={m.lang.label}
    hidden
  >
    {
      options.map((option) => (
        <a
          href={langHref(pathname, search, option.value)}
          class={cn(optionClass, locale === option.value && "is-active")}
          role="option"
          data-lang-option={option.value}
          aria-current={locale === option.value ? "true" : undefined}
        >
          <LangFlag locale={option.value} />
          <span>{option.label}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .lang-switch__menu[hidden] {
    display: none;
  }

  .lang-switch__menu:not([hidden]) {
    display: block;
  }

  .lang-switch__option.is-active {
    color: var(--foreground);
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
  }
</style>
