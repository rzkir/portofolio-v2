---
import Button from "@/components/ui/button.astro";
import Textarea from "@/components/ui/textarea.astro";
import { getLocale, getMessages } from "@/lib/i18n";

const locale = getLocale(Astro);
const t = getMessages(locale).chatModal;

const chatStrings = JSON.stringify({
  welcome: t.welcome,
  clearConfirm: t.clearConfirm,
  replyAck: t.replyAck,
  historyCleared: t.historyCleared,
  system: t.system,
  justNow: t.justNow,
  errorGeneric: t.errorGeneric,
});
---

<div class="chat-modal" data-chat-modal data-chat-strings={chatStrings}>
  <div
    class="chat-modal__backdrop"
    data-chat-backdrop
    hidden
    aria-hidden="true"
  >
  </div>

  <div
    class="chat-modal__panel"
    data-chat-panel
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={t.title}
  >
    <header
      class="chat-modal__header flex w-full shrink-0 items-center justify-between px-6 py-5"
    >
      <div class="flex min-w-0 items-center gap-3">
        <div class="relative shrink-0">
          <div
            class="flex size-12 items-center justify-center rounded-2xl bg-foreground text-background shadow-lg"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-6"
              aria-hidden="true"
            >
              <path
                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
              ></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <span
            class="chat-modal__status absolute -right-1 -bottom-1 size-4 rounded-full border-4 border-background"
          ></span>
        </div>
        <div class="min-w-0">
          <h3
            class="truncate text-base leading-none font-bold tracking-tight text-foreground"
          >
            {t.title}
          </h3>
          <p
            class="chat-modal__status-label mt-1 text-[11px] font-medium tracking-wider uppercase"
          >
            {t.subtitle}
          </p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-1">
        <Button
          variant="icon"
          size="icon"
          class="rounded-xl p-2.5 text-muted-foreground hover:bg-muted hover:text-foreground"
          aria-label={t.clearHistory}
          data-chat-clear
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
        </Button>

        <Button
          variant="icon"
          size="icon"
          class="rounded-xl p-2.5 text-muted-foreground hover:bg-muted hover:text-foreground"
          aria-label={t.closeChat}
          data-chat-close
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </Button>
      </div>
    </header>

    <div
      class="chat-modal__messages min-h-0 w-full flex-1 overflow-y-auto px-6 py-8"
      data-chat-messages
    >
      <div
        class="chat-modal__typing hidden max-w-[85%]"
        data-chat-typing
        aria-live="polite"
        aria-label="Assistant is typing"
      >
        <div
          class="chat-modal__bubble chat-modal__bubble--ai flex items-center gap-1 rounded-2xl px-4 py-3 shadow-sm"
        >
          <span class="chat-modal__typing-dot"></span>
          <span class="chat-modal__typing-dot" style="animation-delay:0.2s"
          ></span>
          <span class="chat-modal__typing-dot" style="animation-delay:0.4s"
          ></span>
        </div>
      </div>
    </div>

    <footer
      class="chat-modal__footer w-full shrink-0 space-y-4 border-t border-border px-6 py-5"
    >
      <div class="chat-modal__quick-replies flex gap-2 overflow-x-auto pb-0.5">
        <Button variant="quick-reply" data-chat-quick="pricing">
          {t.viewPricing}
        </Button>
        <Button variant="quick-reply" data-chat-quick="demo">
          {t.scheduleDemo}
        </Button>
        <Button variant="quick-reply" data-chat-quick="sales">
          {t.contactSales}
        </Button>
      </div>

      <form class="w-full" data-chat-form>
        <Textarea
          variant="chat"
          id="chat-modal-input"
          name="message"
          label={t.placeholder}
          sendLabel={t.send}
          required
        />
      </form>

      <div
        class="flex items-center justify-center gap-1 opacity-40"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-2.5"
        >
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span
          class="text-[9px] font-bold tracking-[0.2em] text-foreground uppercase"
        >
          {t.securedBy}
        </span>
      </div>
    </footer>
  </div>

  <Button
    variant="icon"
    size="icon"
    class="chat-modal__fab size-16 rounded-full bg-foreground text-background shadow-2xl ring-4 ring-background hover:scale-105 hover:bg-foreground hover:text-background active:scale-95"
    aria-label={t.openChat}
    aria-expanded="false"
    data-chat-fab
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6"
      aria-hidden="true"
    >
      <path
        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
      ></path>
    </svg>
    <span class="chat-modal__fab-badge" aria-hidden="true">1</span>
  </Button>
</div>

<style is:global>
  .chat-modal {
    display: contents;
  }

  .chat-modal__backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--chat-layer, 70);
    background: color-mix(in oklch, var(--foreground) 40%, transparent);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }

  .chat-modal--open .chat-modal__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .chat-modal__backdrop[hidden],
  .chat-modal__panel[hidden] {
    display: none !important;
  }

  .chat-modal__fab {
    position: fixed;
    right: 1rem;
    bottom: calc(
      var(--site-mobile-dock-offset, 5.75rem) + env(safe-area-inset-bottom, 0px)
    );
    z-index: calc(var(--chat-layer, 70) + 2);
    pointer-events: auto;
  }

  .chat-modal__fab[hidden] {
    display: none !important;
  }

  .chat-modal__fab-badge {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    display: flex;
    width: 1.25rem;
    height: 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid var(--background);
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
  }

  .chat-modal__panel {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: calc(var(--chat-layer, 70) + 1);
    box-sizing: border-box;
    display: flex;
    width: 440px;
    max-width: calc(100vw - 2rem);
    height: 720px;
    max-height: calc(100dvh - 6rem - env(safe-area-inset-bottom, 0px));
    flex-direction: column;
    overflow: hidden;
    border: 1px solid
      color-mix(in oklch, var(--border) 80%, var(--foreground) 8%);
    border-radius: 2rem;
    background: var(--card);
    box-shadow: 0 32px 64px -16px
      color-mix(in oklch, var(--foreground) 30%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px) scale(0.95);
    transition:
      opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chat-modal--open .chat-modal__panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .chat-modal__header {
    position: sticky;
    top: 0;
    z-index: 2;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 90%, transparent);
    background: color-mix(in oklch, var(--card) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .chat-modal__status {
    background: oklch(0.62 0.14 155);
  }

  .chat-modal__status-label {
    color: oklch(0.52 0.12 155);
  }

  .dark .chat-modal__status-label {
    color: oklch(0.72 0.12 155);
  }

  .chat-modal__messages {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background: color-mix(in oklch, var(--foreground) 4%, var(--card));
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--foreground) 12%, transparent)
      transparent;
  }

  .chat-modal__messages::-webkit-scrollbar {
    width: 5px;
  }

  .chat-modal__messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chat-modal__messages::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 10px;
  }

  .chat-modal__footer {
    background: var(--card);
  }

  .chat-modal__quick-replies {
    scrollbar-width: thin;
  }

  .chat-modal__typing:not(.hidden) {
    display: flex;
    width: max-content;
    max-width: 85%;
    align-self: flex-start;
  }

  /* Flex column parent + align-self (not stretch) = shrink-wrap to text.
     Avoid width:fit-content + child max-width:100% (circular sizing). */
  .chat-modal__message {
    display: flex;
    max-width: 85%;
    flex-direction: column;
    gap: 0.375rem;
    animation: chat-modal-slide-up 0.3s ease-out forwards;
  }

  .chat-modal__message--user {
    align-self: flex-end;
    align-items: flex-end;
  }

  .chat-modal__message--bot {
    align-self: flex-start;
    align-items: flex-start;
  }

  .chat-modal__bubble {
    box-sizing: border-box;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .chat-modal__bubble--ai {
    border-bottom-left-radius: 4px;
    background: color-mix(in oklch, var(--foreground) 10%, var(--card));
    color: var(--foreground);
  }

  .chat-modal__bubble--user {
    border-bottom-right-radius: 4px;
    background: var(--foreground);
    color: var(--background);
    white-space: pre-wrap;
  }

  .chat-modal__meta {
    margin-inline: 0.25rem;
    font-size: 10px;
    line-height: 1;
    color: var(--muted-foreground);
  }

  .chat-modal__bubble.agent-message-content :is(h1, h2, h3, h4, h5, h6) {
    font-size: 0.95em;
  }

  .chat-modal__bubble.agent-message-content :is(ul, ol) {
    padding-left: 1.15rem;
  }

  .chat-modal__bubble.agent-message-content .agent-message-divider {
    margin: 0.65rem 0;
  }

  .chat-modal__typing-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background: color-mix(in oklch, var(--foreground) 45%, transparent);
    animation: chat-modal-typing 1.4s infinite ease-in-out both;
  }

  @keyframes chat-modal-typing {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: scale(0.65);
    }

    40% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes chat-modal-slide-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 640px) {
    .chat-modal__fab,
    .chat-modal__panel {
      right: 2.5rem;
    }

    .chat-modal__panel {
      max-width: calc(100vw - 5rem);
    }
  }

  @media (max-width: 480px) {
    .chat-modal__panel {
      right: 0.75rem;
      left: 0.75rem;
      width: auto;
      max-width: none;
    }
  }
</style>
