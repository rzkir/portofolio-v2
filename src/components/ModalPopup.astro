---
import Button from "@/components/ui/button.astro";
import Card from "@/components/ui/card.astro";
import Textarea from "@/components/ui/textarea.astro";
import { getLocale, getMessages } from "@/lib/i18n";

const locale = getLocale(Astro);
const t = getMessages(locale).chatModal;

const chatStrings = JSON.stringify({
  welcome: t.welcome,
  clearConfirm: t.clearConfirm,
  replyAck: t.replyAck,
  historyCleared: t.historyCleared,
  system: t.system,
  you: t.you,
  justNow: t.justNow,
  errorGeneric: t.errorGeneric,
});
---

<div
  class="chat-modal pointer-events-none fixed inset-0"
  data-chat-modal
  data-chat-strings={chatStrings}
>
  <div
    class="chat-modal__panel chat-modal__panel--hidden"
    data-chat-panel
    hidden
  >
    <Card
      variant="surface"
      title=""
      class="flex h-full flex-col overflow-hidden shadow-2xl"
    >
    <header class="chat-modal__header flex shrink-0 items-center justify-between px-5 py-4 shadow-md">
      <div class="flex items-center gap-3">
        <div class="relative">
          <div class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/10">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5 text-sky-300"
              aria-hidden="true"
            >
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <span class="absolute right-0 bottom-0 size-3 rounded-full border-2 border-[#1e293b] bg-emerald-500"></span>
        </div>
        <div>
          <h3 class="text-base leading-tight font-semibold text-white">{t.title}</h3>
          <p class="flex items-center gap-1 text-xs text-slate-400">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            {t.subtitle}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-1">
        <div class="relative">
          <Button
            variant="icon"
            size="icon"
            class="text-slate-400 hover:bg-white/10 hover:text-white"
            aria-label={t.menu}
            aria-haspopup="menu"
            data-chat-menu-btn
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="1" />
              <circle cx="12" cy="5" r="1" />
              <circle cx="12" cy="19" r="1" />
            </svg>
          </Button>

          <div
            class="absolute top-12 right-0 z-60 hidden w-48 overflow-hidden shadow-xl"
            data-chat-menu
          >
            <Card variant="surface" title="" class="py-1">
            <Button variant="danger-ghost" data-chat-clear>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
                aria-hidden="true"
              >
                <path d="M3 6h18" />
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
              </svg>
              {t.clearHistory}
            </Button>
            <Button variant="ghost" class="w-full justify-start gap-2 rounded-none px-4 py-2.5 text-left text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4"
                aria-hidden="true"
              >
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              {t.settings}
            </Button>
            </Card>
          </div>
        </div>

        <Button
          variant="icon"
          size="icon"
          class="text-slate-400 hover:bg-white/10 hover:text-white"
          aria-label={t.closeChat}
          data-chat-close
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5"
            aria-hidden="true"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </Button>
      </div>
    </header>

    <div
      class="chat-modal__messages agent-scrollbar min-h-0 flex-1 space-y-6 overflow-y-auto bg-background/80 p-6"
      data-chat-messages
    >
      <div
        class="chat-modal__typing hidden items-start gap-3"
        data-chat-typing
        aria-live="polite"
        aria-label="Assistant is typing"
      >
        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4 text-muted-foreground"
            aria-hidden="true"
          >
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </div>
        <div class="rounded-2xl rounded-tl-none border border-border bg-card px-4 py-3 shadow-sm">
          <div class="flex gap-1">
            <span class="chat-modal__typing-dot"></span>
            <span class="chat-modal__typing-dot chat-modal__typing-dot--2"></span>
            <span class="chat-modal__typing-dot chat-modal__typing-dot--3"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="shrink-0 space-y-4 border-t border-border bg-card px-6 py-4">
      <div class="chat-modal__quick-replies flex gap-2 overflow-x-auto pb-1">
        <Button variant="quick-reply" data-chat-quick="pricing">{t.viewPricing}</Button>
        <Button variant="quick-reply" data-chat-quick="demo">{t.scheduleDemo}</Button>
        <Button variant="quick-reply" data-chat-quick="sales">{t.contactSales}</Button>
      </div>

      <form data-chat-form>
        <Textarea
          variant="chat"
          id="chat-modal-input"
          name="message"
          label=""
          placeholder={t.placeholder}
        >
          <Button
            slot="send"
            type="submit"
            variant="primary"
            size="icon"
            class="absolute right-2 bottom-2 size-9 rounded-lg shadow-md"
            aria-label={t.send}
            data-chat-send
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
              aria-hidden="true"
            >
              <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
              <path d="m21.854 2.147-10.94 10.939" />
            </svg>
          </Button>
        </Textarea>
      </form>

      <p class="text-center text-[10px] font-medium tracking-[0.2em] text-muted-foreground uppercase">
        {t.securedBy}
      </p>
    </div>
    </Card>
  </div>

  <Button
    variant="primary"
    size="icon"
    class="chat-modal__fab group size-16 rounded-full border-4 border-background shadow-2xl hover:scale-105 active:scale-95"
    style="background:#1e293b;color:white;"
    aria-label={t.openChat}
    aria-expanded="false"
    data-chat-fab
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="chat-modal__fab-icon chat-modal__fab-icon--open size-6 group-hover:hidden"
      aria-hidden="true"
    >
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      <path d="M8 10h.01" />
      <path d="M12 10h.01" />
      <path d="M16 10h.01" />
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="chat-modal__fab-icon chat-modal__fab-icon--close hidden size-6"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </Button>
</div>

<style is:global>
  .chat-modal {
    pointer-events: none;
    z-index: var(--chat-layer);
  }

  .chat-modal__fab {
    position: fixed;
    right: 1rem;
    bottom: calc(
      var(--site-mobile-dock-offset) + env(safe-area-inset-bottom, 0px)
    );
    z-index: var(--chat-layer);
    pointer-events: auto;
  }

  .chat-modal__panel {
    position: fixed;
    right: 1rem;
    bottom: calc(
      var(--site-mobile-dock-offset) + var(--chat-fab-size) + var(--chat-fab-gap) +
        env(safe-area-inset-bottom, 0px)
    );
    z-index: var(--chat-layer);
    display: flex;
    width: min(420px, calc(100vw - 2rem));
    height: min(600px, calc(100dvh - 12rem - env(safe-area-inset-bottom, 0px)));
    pointer-events: auto;
    transition:
      opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 640px) {
    .chat-modal__fab,
    .chat-modal__panel {
      right: 2.5rem;
    }
  }
</style>

<style>
  .chat-modal__header {
    background: #1e293b;
  }

  .chat-modal__panel--hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
  }

  .chat-modal__panel--visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .chat-modal__fab:hover .chat-modal__fab-icon--open {
    display: none;
  }

  .chat-modal__fab:hover .chat-modal__fab-icon--close,
  .chat-modal__fab[aria-expanded="true"] .chat-modal__fab-icon--open {
    display: none;
  }

  .chat-modal__fab[aria-expanded="true"] .chat-modal__fab-icon--close {
    display: block;
  }

  .chat-modal__quick-replies {
    scrollbar-width: thin;
  }

  .chat-modal__quick-replies::-webkit-scrollbar {
    height: 4px;
  }

  .chat-modal__quick-replies::-webkit-scrollbar-thumb {
    background: color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 999px;
  }

  .chat-modal__typing:not(.hidden) {
    display: flex;
  }

  .chat-modal__typing-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 1px;
    border-radius: 50%;
    background: color-mix(in oklch, var(--muted-foreground) 80%, transparent);
    animation: chat-modal-typing 1.4s infinite ease-in-out;
  }

  .chat-modal__typing-dot--2 {
    animation-delay: 0.2s;
  }

  .chat-modal__typing-dot--3 {
    animation-delay: 0.4s;
  }

  @keyframes chat-modal-typing {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-4px);
    }
  }
</style>
