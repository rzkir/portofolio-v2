---
import FadeInText from "@astroanimate/core/FadeInText";

const cinematic = "cubic-bezier(0.32, 0.72, 0, 1)";
---

<div
  id="splash-screen"
  aria-hidden="true"
  data-header-theme="inverse"
  data-cursor-surface="invert"
  class="splash-screen fixed inset-0 z-100 flex flex-col items-center justify-center"
>
  <div
    id="splash-content"
    class="flex flex-col items-center gap-6 transition-[transform,opacity] duration-700"
    style="transition-timing-function: var(--ease-cinematic)"
  >
    <FadeInText
      as="span"
      enhance={false}
      duration={1.1}
      delay={0}
      blur="0px"
      yOffset={24}
      easing={cinematic}
      class="font-display text-[8rem] leading-none text-foreground/90 italic md:text-[12rem]"
    >
      RR
    </FadeInText>

    <FadeInText
      enhance={false}
      duration={0.7}
      delay={0.35}
      blur="0px"
      yOffset={14}
      easing={cinematic}
      class="flex flex-col items-center gap-2"
    >
      <span
        class="font-mono text-xs tracking-[0.3em] text-foreground/78 uppercase"
        >Rizki Ramadhan</span
      >
      <span
        class="font-mono text-xs tracking-[0.3em] text-foreground/55 uppercase"
        >Fullstack Developer</span
      >
    </FadeInText>
  </div>

  <div
    id="splash-progress-wrap"
    class="absolute bottom-10 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3"
  >
    <span
      id="splash-progress"
      class="font-mono text-md tracking-[0.24em] text-foreground/65 tabular-nums"
      aria-hidden="true"
    >
      000
    </span>
    <span class="block h-px w-24 bg-foreground/35"></span>
    <span
      id="splash-status"
      class="splash-status font-mono text-[10px] tracking-[0.28em] text-foreground/45 uppercase"
      data-state="preparing"
      aria-live="polite"
    >
      Preparing content<span class="splash-status__dots" aria-hidden="true"></span>
    </span>
  </div>
</div>

<script is:inline>
  (function () {
    var splash = document.getElementById("splash-screen");
    if (!splash || splash.getAttribute("data-bound") === "true") return;

    var seen = document.documentElement.classList.contains("splash-seen");
    try {
      seen = seen || sessionStorage.getItem("splash-seen") === "1";
    } catch (e) {}

    if (seen) {
      splash.remove();
      document.documentElement.classList.remove("splash-pending");
      document.documentElement.classList.add("splash-seen");
      return;
    }

    document.documentElement.classList.add("splash-pending");
    splash.setAttribute("data-bound", "true");

    var progressEl = document.getElementById("splash-progress");
    var statusEl = document.getElementById("splash-status");
    var minMs = 900;
    var maxMs = 4000;
    var exitMs = 350;
    var start = performance.now();
    var done = false;
    var raf = 0;

    function pad(value) {
      return String(value).padStart(3, "0");
    }

    function setProgress(value) {
      var n = Math.max(0, Math.min(100, Math.round(value)));
      if (progressEl) progressEl.textContent = pad(n);
      if (statusEl) {
        statusEl.setAttribute("data-state", n < 8 ? "preparing" : "ready");
      }
    }

    function unlock() {
      document.documentElement.classList.remove("splash-pending");
      try {
        window.dispatchEvent(new Event("site-header:sync"));
      } catch (e) {}
    }

    function finish() {
      if (done) return;
      done = true;
      cancelAnimationFrame(raf);
      setProgress(100);
      try {
        sessionStorage.setItem("splash-seen", "1");
      } catch (e) {}
      splash.removeAttribute("data-header-theme");
      unlock();
      splash.classList.add("is-exiting");
      document.documentElement.classList.add("splash-seen");
      window.setTimeout(function () {
        splash.remove();
      }, exitMs);
    }

    function shouldFinish(elapsed) {
      var ready =
        document.readyState === "interactive" ||
        document.readyState === "complete";
      return elapsed >= maxMs || (ready && elapsed >= minMs);
    }

    function tick(now) {
      if (done) return;
      var elapsed = now - start;
      var ready =
        document.readyState === "interactive" ||
        document.readyState === "complete";
      var ratio = Math.min(elapsed / maxMs, ready ? 1 : 0.92);
      setProgress(ratio * 100);
      if (shouldFinish(elapsed)) {
        finish();
        return;
      }
      raf = requestAnimationFrame(tick);
    }

    setProgress(0);
    raf = requestAnimationFrame(tick);
    document.addEventListener("readystatechange", function () {
      tick(performance.now());
    });
    window.addEventListener("load", function () {
      tick(performance.now());
    });
    window.setTimeout(function () {
      tick(performance.now());
    }, maxMs);
  })();
</script>
